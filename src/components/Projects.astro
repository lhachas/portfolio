  /* ==========================================================================
     Filter Buttons & GitHub Callout Banner
     ========================================================================== */
  .project-filter-btn {
    border: 2px solid var(--card-border);
    background-color: var(--th-secondary);
    color: var(--txt-primary);
    box-shadow: 0 2px 0 var(--card-border);
  }

  .project-filter-btn:hover {
    border-color: var(--brand-gold);
    color: var(--brand-gold);
    transform: translateY(-1px);
    box-shadow: 0 3px 0 var(--brand-gold);
  }

  .project-filter-btn:active {
    transform: scale(0.96);
  }

  .project-filter-btn.active {
    background-color: var(--brand-gold);
    border-color: var(--brand-gold);
    color: #ffffff !important;
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.25);
  }

  .project-filter-btn.active span {
    color: #ffffff !important;
  }

  .github-callout-banner {
    background-color: #14171f;
    border: 2px solid #2d3546;
    box-shadow: 0 4px 0 #0d0f14;
    text-decoration: none;
  }

  .github-callout-banner:hover {
    border-color: var(--brand-gold);
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--brand-gold);
  }

  [data-theme="light"] .github-callout-banner {
    background-color: #0e3d65;
    border-color: #0e3d65;
    box-shadow: 0 4px 0 #092238;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupProjectsCarousel() {
    const track = document.getElementById('project-carousel-track') as HTMLElement | null;
    const prevBtn = document.getElementById('carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('carousel-next') as HTMLButtonElement | null;
    const currentIndicator = document.getElementById('carousel-current') as HTMLElement | null;
    const totalIndicator = document.getElementById('carousel-total') as HTMLElement | null;
    const progressBar = document.getElementById('carousel-progress-bar') as HTMLElement | null;
    const dotButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-dot-btn'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));

    if (!track || !cards.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Initial GSAP ScrollTrigger Entrance Reveal
    if (!prefersReducedMotion) {
      gsap.fromTo(
        cards,
        { y: 28, autoAlpha: 0, scale: 0.98 },
        {
          y: 0,
          autoAlpha: 1,
          scale: 1,
          duration: 0.55,
          stagger: 0.08,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: track,
            start: 'top 85%',
            once: true,
          },
          clearProps: 'transform,opacity,visibility,scale',
        }
      );
    }

    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let hasDragged = false;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;

    // Helper: Get currently visible cards based on active filter
    function getVisibleCards(): HTMLElement[] {
      return cards.filter((card) => card.style.display !== 'none');
    }

    // Helper: Update Navigation state, Counter, and Dots
    function updateCarouselState() {
      if (!track) return;
      const visibleCards = getVisibleCards();
      const total = visibleCards.length;
      if (totalIndicator) {
        totalIndicator.textContent = String(total).padStart(2, '0');
      }

      if (total === 0) {
        if (currentIndicator) currentIndicator.textContent = '00';
        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) nextBtn.disabled = true;
        if (progressBar) progressBar.style.width = '0%';
        return;
      }

      // Calculate which card is closest to the left edge of track
      const trackLeft = track.getBoundingClientRect().left;
      let closestIdx = 0;
      let minDiff = Infinity;

      visibleCards.forEach((card, idx) => {
        const cardLeft = card.getBoundingClientRect().left;
        const diff = Math.abs(cardLeft - trackLeft);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      // Update current index counter
      if (currentIndicator) {
        currentIndicator.textContent = String(closestIdx + 1).padStart(2, '0');
      }

      // Update architectural progress bar smoothly
      if (progressBar && total > 0) {
        const percent = Math.min(100, Math.max(10, ((closestIdx + 1) / total) * 100));
        progressBar.style.width = `${percent}%`;
      }

      // Update focused slide styling without distorting transforms
      visibleCards.forEach((card, idx) => {
        if (idx === closestIdx) {
          card.classList.add('is-focused');
        } else {
          card.classList.remove('is-focused');
        }
      });

      // Update Dots
      dotButtons.forEach((dot) => {
        const dotIdx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        const originalIndex = parseInt(visibleCards[closestIdx]?.getAttribute('data-index') || '0', 10);
        const isActive = dotIdx === originalIndex;
        dot.classList.toggle('active', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Update Prev / Next button states
      const maxScrollLeft = track.scrollWidth - track.clientWidth - 5;
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 5;
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= maxScrollLeft;
    }

    // Scroll by N cards
    function scrollByCard(direction: number) {
      if (!track) return;
      const visibleCards = getVisibleCards();
      if (!visibleCards.length) return;

      const trackLeft = track.getBoundingClientRect().left;
      let closestIdx = 0;
      let minDiff = Infinity;

      visibleCards.forEach((card, idx) => {
        const diff = Math.abs(card.getBoundingClientRect().left - trackLeft);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      let targetIdx = closestIdx + direction;
      targetIdx = Math.max(0, Math.min(targetIdx, visibleCards.length - 1));

      const targetCard = visibleCards[targetIdx];
      if (targetCard) {
        const targetScroll = targetCard.offsetLeft - track.offsetLeft;
        track.scrollTo({
          left: targetScroll,
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });
      }
    }

    // Scroll to specific slide index
    function scrollToCardIndex(index: number) {
      if (!track) return;
      const card = cards.find((c) => c.getAttribute('data-index') === String(index));
      if (card && card.style.display !== 'none') {
        const targetScroll = card.offsetLeft - track.offsetLeft;
        track.scrollTo({
          left: targetScroll,
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });
      }
    }

    // Snap to closest visible card on drag release
    function snapToNearestCard() {
      if (!track) return;
      const visibleCards = getVisibleCards();
      if (!visibleCards.length) return;
      const trackLeft = track.getBoundingClientRect().left;
      let closestCard = visibleCards[0];
      let minDiff = Infinity;
      visibleCards.forEach((card) => {
        const diff = Math.abs(card.getBoundingClientRect().left - trackLeft);
        if (diff < minDiff) {
          minDiff = diff;
          closestCard = card;
        }
      });
      if (closestCard) {
        const targetScroll = closestCard.offsetLeft - track.offsetLeft;
        track.scrollTo({
          left: targetScroll,
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });
      }
    }

    // Micro-bounce spring animation on navigation buttons
    const triggerBtnBounce = (btn: HTMLElement | null) => {
      if (!btn || prefersReducedMotion) return;
      gsap.fromTo(btn, { scale: 0.88 }, { scale: 1, duration: 0.35, ease: 'back.out(2)' });
    };

    // Event: Prev / Next buttons
    prevBtn?.addEventListener('click', () => {
      triggerBtnBounce(prevBtn);
      scrollByCard(-1);
    });
    nextBtn?.addEventListener('click', () => {
      triggerBtnBounce(nextBtn);
      scrollByCard(1);
    });

    // Interactive Internal Tabs on each Project Card
    cards.forEach((card) => {
      const tabButtons = Array.from(card.querySelectorAll<HTMLButtonElement>('.card-tab-btn'));
      const tabPanes = Array.from(card.querySelectorAll<HTMLElement>('.card-tab-pane'));

      tabButtons.forEach((tabBtn) => {
        tabBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetId = tabBtn.getAttribute('data-tab-target');
          if (!targetId) return;

          tabButtons.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          tabBtn.classList.add('active');
          tabBtn.setAttribute('aria-selected', 'true');

          tabPanes.forEach((pane) => {
            if (pane.id === targetId) {
              pane.classList.remove('hidden');
              pane.classList.add('active');
              if (!prefersReducedMotion) {
                gsap.fromTo(pane, { opacity: 0, y: 4 }, { opacity: 1, y: 0, duration: 0.25, ease: 'power2.out' });
              }
            } else {
              pane.classList.add('hidden');
              pane.classList.remove('active');
            }
          });
        });
      });
    });

    // Event: Pagination dot clicks
    dotButtons.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        scrollToCardIndex(idx);
      });
    });

    // Event: Scroll listener (debounced with requestAnimationFrame)
    let isTicking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (!isTicking) {
          window.requestAnimationFrame(() => {
            updateCarouselState();
            isTicking = false;
          });
          isTicking = true;
        }
      },
      { passive: true },
    );

    // Event: Full Keyboard Navigation
    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollByCard(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollByCard(1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        scrollToCardIndex(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        const visible = getVisibleCards();
        if (visible.length) {
          const lastIdx = parseInt(visible[visible.length - 1].getAttribute('data-index') || '0', 10);
          scrollToCardIndex(lastIdx);
        }
      } else if (e.key === 'PageUp') {
        e.preventDefault();
        scrollByCard(-2);
      } else if (e.key === 'PageDown') {
        e.preventDefault();
        scrollByCard(2);
      }
    });

    // Event: Pointer Drag-to-Scroll Physics
    track.addEventListener('pointerdown', (e: PointerEvent) => {
      if ((e.target as HTMLElement)?.closest('button, a')) return;
      isDown = true;
      hasDragged = false;
      startX = e.pageX - track.offsetLeft;
      scrollStart = track.scrollLeft;
      lastX = e.pageX;
      lastTime = Date.now();
      velocity = 0;
      track.classList.add('is-dragging');
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDown || !track) return;
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.35;
      if (Math.abs(walk) > 6) {
        hasDragged = true;
      }
      track.scrollLeft = scrollStart - walk;

      const now = Date.now();
      const dt = now - lastTime;
      if (dt > 0) {
        velocity = (e.pageX - lastX) / dt;
        lastX = e.pageX;
        lastTime = now;
      }
    });

    const stopDragging = () => {
      if (!isDown || !track) return;
      isDown = false;
      track.classList.remove('is-dragging');

      if (Math.abs(velocity) > 0.35) {
        scrollByCard(velocity > 0 ? -1 : 1);
      } else {
        snapToNearestCard();
      }
      updateCarouselState();
    };

    window.addEventListener('pointerup', stopDragging);
    window.addEventListener('pointercancel', stopDragging);

    // Suppress accidental link click while dragging
    track.addEventListener(
      'click',
      (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          hasDragged = false;
        }
      },
      true,
    );

    // Category Filter Integration with Fluid Re-Entrance Transition
    filterButtons.forEach((btn, bIdx) => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-project-filter');
        if (!filterValue || !track) return;

        // Update tab buttons
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filterValue === 'all' || category === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Dynamic re-entrance cascade
        if (!prefersReducedMotion) {
          const visible = getVisibleCards();
          gsap.fromTo(
            visible,
            { opacity: 0, scale: 0.97, y: 16 },
            {
              opacity: 1,
              scale: 1,
              y: 0,
              duration: 0.35,
              stagger: 0.05,
              ease: 'power2.out',
              clearProps: 'transform,opacity,scale',
            }
          );
        }

        // Filter dots
        dotButtons.forEach((dot) => {
          const dotIdx = dot.getAttribute('data-dot-index');
          const correspondingCard = cards.find((c) => c.getAttribute('data-index') === dotIdx);
          if (correspondingCard && correspondingCard.style.display !== 'none') {
            dot.style.display = 'inline-block';
          } else {
            dot.style.display = 'none';
          }
        });

        // Reset scroll position smoothly to first visible card
        track.scrollTo({ left: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        setTimeout(updateCarouselState, 150);
      });

      // Filter arrow key navigation
      btn.addEventListener('keydown', (e) => {
        let targetIndex = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          targetIndex = (bIdx + 1) % filterButtons.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          targetIndex = (bIdx - 1 + filterButtons.length) % filterButtons.length;
        } else if (e.key === 'Home') {
          targetIndex = 0;
        } else if (e.key === 'End') {
          targetIndex = filterButtons.length - 1;
        }

        if (targetIndex >= 0) {
          e.preventDefault();
          const targetBtn = filterButtons[targetIndex];
          targetBtn.focus();
          targetBtn.click();
        }
      });
    });

    // Initial state update
    updateCarouselState();
  }

  // Initialize on DOM ready and Astro page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectsCarousel);
  } else {
    setupProjectsCarousel();
  }
  document.addEventListener('astro:page-load', setupProjectsCarousel);
</script>
