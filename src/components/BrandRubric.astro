---
/**
 * BrandRubric — rúbrica caligráfica de la marca LHachaS (huella visual).
 * Trazo único reutilizable: firma del navbar y subrayado artesanal del H1.
 * `pathLength="1"` permite animar el dibujo del trazo (stroke-dashoffset 1 → 0).
 * Con `stretch` el SVG se expande al 100% del contenedor (distorsión controlada)
 * para que la rúbrica subraye exactamente el ancho del texto tecleado.
 * `variant="underline"` usa un trazo simple sin lazo: se estira limpio a cualquier ancho.
 */
interface Props {
  width?: number | string;
  height?: number | string;
  class?: string;
  stretch?: boolean;
  variant?: 'signature' | 'underline';
}

const { width = 140, height = 14, class: className = '', stretch = false, variant = 'signature' } = Astro.props;
const sizing = stretch ? { width: '100%', height: '100%' } : { width, height };
const isUnderline = variant === 'underline';
---

<svg
  class={className}
  width={sizing.width}
  height={sizing.height}
  viewBox="0 0 140 14"
  preserveAspectRatio={stretch ? 'none' : 'xMidYMid meet'}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d={isUnderline ? 'M3 9.5 C 42 13.5, 92 12.5, 137 5' : 'M2 3C28 11 72 13 136 3.5C114 13 82 11.5 60 9C38 6.5 16 11.5 8 8'}
    stroke="var(--brand-gold)"
    stroke-width={stretch ? 2.6 : 2}
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect={stretch ? 'non-scaling-stroke' : undefined}
    pathLength="1"
  ></path>
</svg>
