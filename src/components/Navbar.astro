---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import BrandSignature from './BrandSignature.astro';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
  activeSection?: string;
}

const { locale = 'es', activeSection = 'home' } = Astro.props;
const { navigation, profile } = await getPortfolioContent(locale);
const navItems = navigation.items;
const { languageSwitcher } = navigation;

const basePath = withBase(locale === 'en' ? '/en/' : '/');

const navIconMap: Record<string, 'home' | 'user' | 'code' | 'terminal' | 'briefcase' | 'layers' | 'message'> = {
  home: 'home',
  about: 'user',
  skills: 'code',
  projects: 'terminal',
  experiences: 'briefcase',
  services: 'layers',
  contact: 'message',
};
---

<!-- START NAVBAR -->
<header>
  <nav
    class="navbar-custom fixed top-0 left-0 right-0"
    id="navbar"
    aria-label={navigation.ariaLabel}
    data-base-path={basePath}
    data-locale={locale}
    data-active-section={activeSection}
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex min-h-[72px] items-center justify-between">
        <!-- Brand Signature Logo (Natural Cursive Rubric + Avatar) -->
        <a
          class="navbar-brand-logo flex items-center"
          href={basePath}
          data-nav-link="home"
          aria-label={navigation.brandAriaLabel}
        >
          <BrandSignature
            avatarImage={profile.avatarImage}
            avatarAlt={profile.avatarAlt}
            subtitle={profile.brandSubtitle || 'Backend & Full Stack'}
          />
        </a>

        <!-- Desktop Navigation Links (Clean SVG Icons + Uppercase Labels + Active Block) -->
        <ul class="hidden lg:flex items-stretch mx-auto" id="navbar-navlist">
          {
            navItems.map((item, index) => {
              const iconName = navIconMap[item.id] || 'home';
              const href = item.id === 'home'
                ? basePath
                : withBase(locale === 'en' ? `/en/${item.id}` : `/${item.id}`);
              const isActive = activeSection ? item.id === activeSection : index === 0;
              return (
                <li class="flex">
                  <a
                    href={href}
                    data-nav-link={item.id}
                    class:list={['nav-item-link', { active: isActive }]}
                  >
                    <Icon name={iconName} size={18} class="nav-icon mb-1" />
                    <span class="nav-label">{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <!-- Right Controls: Phone + Language Switcher (ES/EN) + Theme Switcher + Mobile Hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href={`tel:${profile.phoneClean}`}
            class="hidden xl:inline-flex items-center gap-1.5 text-white hover:text-gold transition-colors text-sm font-semibold tracking-wide"
            aria-label={profile.phone}
          >
            <Icon name="phone" size={15} class="text-gold" />
            <span class="text-sm font-normal tracking-wider">{profile.phone}</span>
          </a>

          <!-- Zero-friction Language Switcher (100% Solid Segmented Pill - Clear Active Selection) -->
          <a
            href={withBase(languageSwitcher.targetHref)}
            data-lang-switch
            class="lang-segmented-btn inline-flex h-11 items-center justify-center gap-1.5 rounded-full px-2 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none"
            aria-label={languageSwitcher.ariaLabel}
            title={languageSwitcher.title}
          >
            <Icon name="globe" size={15} class="lang-globe-icon shrink-0 ml-1.5 text-gold" />
            <span class="lang-pill-badge active" aria-current="true">{languageSwitcher.currentCode}</span>
            <span class="lang-pill-badge target">{languageSwitcher.targetCode}</span>
          </a>

          <!-- Light / Dark Mode Switcher (SVG Icons - 100% Solid) -->
          <button
            type="button"
            id="theme-toggle-btn"
            data-magnetic
            class="nav-control-btn inline-flex h-11 w-11 items-center justify-center rounded-full cursor-pointer"
            aria-label={navigation.themeToggleAriaLabel}
            title={navigation.themeToggleTitle}
          >
            <span id="theme-icon-moon">
              <Icon name="moon" size={18} />
            </span>
            <span id="theme-icon-sun">
              <Icon name="sun" size={18} />
            </span>
          </button>

          <!-- Mobile Menu Button (Strictly hidden on desktop: max-lg:inline-flex lg:hidden) -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="nav-control-btn mobile-menu-btn max-lg:inline-flex lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-full cursor-pointer relative"
            aria-controls="navbarCollapse"
            aria-expanded="false"
            aria-label={navigation.mobileMenuAriaLabel}
          >
            <span id="mobile-icon-bars" class="mobile-icon-layer mobile-icon-bars" aria-hidden="true">
              <Icon name="menu" size={22} />
            </span>
            <span id="mobile-icon-close" class="mobile-icon-layer mobile-icon-close" aria-hidden="true">
              <Icon name="close" size={22} />
            </span>
          </button>
        </div>
      </div>

      <!-- Mobile Collapsible Navigation (Strictly hidden on desktop) -->
      <div
        id="navbarCollapse"
        class="hidden lg:hidden border-t-2 border-[#252a37] bg-[#14171f] pb-4 pt-2"
        aria-hidden="true"
      >
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            navItems.map((item, index) => {
              const iconName = navIconMap[item.id] || 'home';
              const href = item.id === 'home'
                ? basePath
                : withBase(locale === 'en' ? `/en/${item.id}` : `/${item.id}`);
              const isActive = activeSection ? item.id === activeSection : index === 0;
              return (
                <li>
                  <a
                    href={href}
                    data-nav-link={item.id}
                    class:list={['nav-item-link rounded-lg py-3', { active: isActive }]}
                  >
                    <Icon name={iconName} size={18} class="nav-icon mb-1" />
                    <span class="nav-label">{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="mt-3 pt-3 border-t-2 border-[#252a37] flex flex-wrap items-center justify-center gap-4 sm:hidden">
          <a
            href={`tel:${profile.phoneClean}`}
            class="inline-flex items-center gap-2 text-white text-sm font-semibold"
          >
            <Icon name="phone" size={16} class="text-gold" />
            <span>{profile.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
<!-- END NAVBAR -->

<script>
  function setupNavbar() {
    const navbar = document.getElementById('navbar');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('navbarCollapse');
    const themeBtn = document.getElementById('theme-toggle-btn');
    const langLinks = document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]');

    const basePath = navbar?.getAttribute('data-base-path') || '/';
    const locale = navbar?.getAttribute('data-locale') || 'es';
    let currentActiveSection = navbar?.getAttribute('data-active-section') || 'home';
    let isProgrammaticScroll = false;

    const sectionSlugMap: Record<string, string> = {
      home: 'home',
      inicio: 'home',
      about: 'about',
      perfil: 'about',
      profile: 'about',
      skills: 'skills',
      habilidades: 'skills',
      projects: 'projects',
      proyectos: 'projects',
      experiences: 'experiences',
      experiencia: 'experiences',
      experience: 'experiences',
      services: 'services',
      soluciones: 'services',
      solutions: 'services',
      contact: 'contact',
      contacto: 'contact',
    };

    function updateActiveNav(sectionId: string) {
      const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('#navbar [data-nav-link]');
      allNavLinks.forEach((link) => {
        const linkSection = link.getAttribute('data-nav-link');
        link.classList.toggle('active', linkSection === sectionId);
      });
    }

    function scrollToSection(sectionId: string, smooth = true) {
      const targetEl = document.getElementById(sectionId);
      if (!targetEl) return false;
      const navOffset = navbar ? navbar.offsetHeight : 72;
      const targetY = sectionId === 'home' ? 0 : targetEl.getBoundingClientRect().top + window.scrollY - navOffset + 2;
      window.scrollTo({
        top: Math.max(0, targetY),
        behavior: smooth ? 'smooth' : ('instant' as ScrollBehavior),
      });
      return true;
    }

    function getCleanUrlForSection(sectionId: string): string {
      if (sectionId === 'home') {
        return basePath;
      }
      const prefix = basePath.endsWith('/') ? basePath : `${basePath}/`;
      return `${prefix}${sectionId}`;
    }

    // Accessible Mobile Menu Toggle
    function setMobileMenuOpen(open: boolean) {
      if (!mobileBtn || !mobileMenu) return;
      mobileBtn.setAttribute('aria-expanded', String(open));
      mobileMenu.classList.toggle('hidden', !open);
      mobileMenu.setAttribute('aria-hidden', String(!open));
    }

    mobileBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      setMobileMenuOpen(!isExpanded);
    });

    // Close on Escape key press and refocus button
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileBtn?.getAttribute('aria-expanded') === 'true') {
        setMobileMenuOpen(false);
        mobileBtn.focus();
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (
        mobileBtn?.getAttribute('aria-expanded') === 'true' &&
        navbar &&
        !navbar.contains(e.target as Node)
      ) {
        setMobileMenuOpen(false);
      }
    });

    // Auto-close on viewport resize to desktop
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth >= 1024 && mobileBtn?.getAttribute('aria-expanded') === 'true') {
          setMobileMenuOpen(false);
        }
      },
      { passive: true }
    );

    // Toggle Light/Dark Theme (state-driven via html[data-theme])
    themeBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('user-theme', next);
      } catch (e) {}
    });

    // Handle all friendly in-page navigation links (navbar, hero, about, footer, etc.)
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    allNavLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const sectionId = link.getAttribute('data-nav-link');
        if (!sectionId) return;

        const resolvedId = sectionSlugMap[sectionId] || sectionId;
        const targetEl = document.getElementById(resolvedId);
        if (targetEl) {
          e.preventDefault();
          isProgrammaticScroll = true;

          const targetUrl = link.getAttribute('href') || getCleanUrlForSection(resolvedId);
          history.pushState({ section: resolvedId }, '', targetUrl);

          scrollToSection(resolvedId, true);
          currentActiveSection = resolvedId;
          updateActiveNav(resolvedId);

          if (window.innerWidth < 1024) {
            setMobileMenuOpen(false);
          }

          setTimeout(() => {
            isProgrammaticScroll = false;
          }, 700);
        }
      });
    });

    // Handle Language Switcher with clean URL (no hash!)
    langLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const rawTargetHref = link.getAttribute('href') || '';
        const baseTarget = rawTargetHref.split('#')[0];
        const activeId = currentActiveSection || 'home';
        if (activeId && activeId !== 'home') {
          const cleanBase = baseTarget.endsWith('/') ? baseTarget : `${baseTarget}/`;
          link.setAttribute('href', `${cleanBase}${activeId}`);
        } else {
          link.setAttribute('href', baseTarget);
        }
      });
    });

    // Handle browser Back / Forward (popstate)
    window.addEventListener('popstate', (e) => {
      let sectionId = e.state?.section;
      if (!sectionId) {
        const parts = window.location.pathname.replace(/\/$/, '').split('/');
        const lastPart = parts[parts.length - 1];
        sectionId = sectionSlugMap[lastPart] || 'home';
      }
      isProgrammaticScroll = true;
      scrollToSection(sectionId, true);
      currentActiveSection = sectionId;
      updateActiveNav(sectionId);
      setTimeout(() => {
        isProgrammaticScroll = false;
      }, 700);
    });

    // Automatically handle direct visits, legacy bookmarks with #hash, or dynamic section paths
    if (window.location.hash) {
      const hashSlug = window.location.hash.replace('#', '');
      const resolvedFromHash = sectionSlugMap[hashSlug] || hashSlug;
      const targetFromHash = document.getElementById(resolvedFromHash);
      if (targetFromHash) {
        const cleanUrl = getCleanUrlForSection(resolvedFromHash);
        history.replaceState({ section: resolvedFromHash }, '', cleanUrl);
        currentActiveSection = resolvedFromHash;
        updateActiveNav(resolvedFromHash);
        setTimeout(() => {
          scrollToSection(resolvedFromHash, false);
        }, 60);
      }
    } else {
      const initialAttr = document.getElementById('main-content')?.getAttribute('data-initial-section');
      const resolvedInitial = initialAttr && sectionSlugMap[initialAttr] ? sectionSlugMap[initialAttr] : null;
      if (resolvedInitial && resolvedInitial !== 'home') {
        currentActiveSection = resolvedInitial;
        updateActiveNav(resolvedInitial);
        setTimeout(() => {
          scrollToSection(resolvedInitial, false);
        }, 60);
      }
    }

    // Sticky Navbar state using passive scroll
    const updateSticky = () => {
      if (!navbar) return;
      if (window.scrollY > 40) {
        navbar.classList.add('nav-sticky');
      } else {
        navbar.classList.remove('nav-sticky');
      }
    };
    updateSticky();
    window.addEventListener('scroll', updateSticky, { passive: true });

    // Deterministic ScrollSpy syncing clean URL without hash
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    let scrollSpyTimer: number | null = null;

    const updateScrollSpy = () => {
      if (isProgrammaticScroll) return;

      const scrollPos = window.scrollY + 240;
      let currentId = 'home';
      if (window.scrollY >= 120) {
        for (const section of sections) {
          if (section.offsetTop <= scrollPos) {
            currentId = section.id;
          }
        }
      }

      if (currentId !== currentActiveSection) {
        currentActiveSection = currentId;
        updateActiveNav(currentId);

        // Update address bar cleanly using replaceState (debounced slightly)
        if (scrollSpyTimer) window.clearTimeout(scrollSpyTimer);
        scrollSpyTimer = window.setTimeout(() => {
          if (!isProgrammaticScroll) {
            const cleanUrl = getCleanUrlForSection(currentId);
            if (window.location.pathname !== cleanUrl && window.location.hash === '') {
              history.replaceState({ section: currentId }, '', cleanUrl);
            }
          }
        }, 120);
      }
    };

    updateScrollSpy();
    window.addEventListener('scroll', updateScrollSpy, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavbar);
  } else {
    setupNavbar();
  }
  document.addEventListener('astro:page-load', setupNavbar);
</script>