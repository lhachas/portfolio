---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { styleSwitcher } = await getPortfolioContent(locale);
---

<!-- START SWITCHER -->
<div id="style-switcher" aria-label={styleSwitcher.ariaLabel}>
  <div>
    <p class="text-white text-center text-sm font-bold uppercase tracking-wider mb-2">
      {styleSwitcher.title}
    </p>
    <ul class="grid grid-cols-3 gap-2.5 p-2 justify-items-center" role="list">
      {
        styleSwitcher.themes.map((theme, idx) => (
          <li>
            <button
              type="button"
              data-accent-color={theme.hex}
              data-accent-hover={theme.hoverHex}
              title={theme.name}
              aria-label={theme.name}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class:list={[
                'style-swatch-btn h-9 w-9 rounded-full border-2 border-[#4a4a4a] transition-transform hover:scale-110 hover:border-white cursor-pointer',
                { 'is-active': idx === 0 },
              ]}
              style={`background-color: ${theme.hex};`}
            />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="bottom">
    <button
      type="button"
      id="style-switcher-toggle"
      class="settings-btn"
      aria-label={styleSwitcher.toggleAriaLabel}
      aria-expanded="false"
    >
      <Icon name="palette" size={20} class="ti-spin-slow text-current" />
    </button>
  </div>
</div>
<!-- END SWITCHER -->

<!-- Back to top -->
<a
  href={withBase(locale === 'en' ? '/en/' : '/')}
  id="back-to-top"
  data-nav-link="home"
  class="back-to-top-btn"
  aria-label={styleSwitcher.backToTopAriaLabel}
>
  <Icon name="chevron-up" size={20} />
</a>

<script>
  import { DEFAULT_ACCENT, resolveAccentSlots } from '../data/accents';

  (() => {
    const switcher = document.getElementById('style-switcher');
    const toggleBtn = document.getElementById('style-switcher-toggle');
    const swatches = document.querySelectorAll('[data-accent-color]');
    const backToTop = document.getElementById('back-to-top');
    const validHex = /^#[0-9a-fA-F]{6}$/;

    const syncActiveSwatch = (activeHex: string) => {
      const normalized = (activeHex || DEFAULT_ACCENT.primary).toLowerCase();
      swatches.forEach((swatch) => {
        const swatchHex = (swatch.getAttribute('data-accent-color') || '').toLowerCase();
        const isMatch = swatchHex === normalized;
        swatch.classList.toggle('is-active', isMatch);
        swatch.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
      });
    };

    const applyAccentPalette = (primary: string, hover: string, persist: boolean) => {
      const normalizedPrimary = (primary || DEFAULT_ACCENT.primary).toLowerCase();
      const onAccent = '#ffffff';
      const slots = resolveAccentSlots(normalizedPrimary);

      const root = document.documentElement.style;
      root.setProperty('--brand-gold', normalizedPrimary);
      root.setProperty('--brand-gold-hover', hover);
      root.setProperty('--brand-on-gold', onAccent);
      root.setProperty('--title-icon-color', normalizedPrimary);
      slots.forEach((slotColor, index) => {
        root.setProperty(`--accent-${index + 1}`, slotColor);
      });

      syncActiveSwatch(normalizedPrimary);

      if (persist) {
        try {
          localStorage.setItem('user-accent-hex', normalizedPrimary);
          localStorage.setItem('user-accent-hover', hover);
        } catch (err) {}
      }

      window.dispatchEvent(
        new CustomEvent('portfolio:accent-change', {
          detail: { primary: normalizedPrimary, hover, onAccent, slots },
        })
      );
    };

    try {
      const savedPrimary = localStorage.getItem('user-accent-hex') || DEFAULT_ACCENT.primary;
      const savedHover = localStorage.getItem('user-accent-hover') || DEFAULT_ACCENT.hover;
      if (validHex.test(savedPrimary) && validHex.test(savedHover)) {
        applyAccentPalette(savedPrimary, savedHover, false);
      } else {
        applyAccentPalette(DEFAULT_ACCENT.primary, DEFAULT_ACCENT.hover, false);
      }
    } catch (err) {
      applyAccentPalette(DEFAULT_ACCENT.primary, DEFAULT_ACCENT.hover, false);
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!switcher) return;
      const isOpen = switcher.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    swatches.forEach((swatch) => {
      swatch.addEventListener('click', () => {
        const primary = swatch.getAttribute('data-accent-color') || '';
        const hover = swatch.getAttribute('data-accent-hover') || '';
        applyAccentPalette(primary, hover, true);
      });
    });

    const onScroll = () => {
      if (!backToTop) return;
      if (window.scrollY > 300) {
        backToTop.classList.add('visible');
      } else {
        backToTop.classList.remove('visible');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

