# ============================================================================
# Configuración del Formulario de Contacto (Astro 5 + GitHub Pages)
# Destinatario Oficial: lionelsh.salazar@gmail.com
# ============================================================================
# Configura cualquiera de las siguientes variables en tu archivo .env local
# o en GitHub Actions (Settings -> Secrets and variables -> Actions -> Variables):

# Opción A (Recomendada - Gratuita sin registro): Web3Forms (https://web3forms.com/)
# Ingresa lionelsh.salazar@gmail.com en https://web3forms.com/#start y pega tu Access Key:
PUBLIC_WEB3FORMS_KEY=

# Opción B: Formspree (https://formspree.io/)
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/tu_codigo_formspree

# Opción C: Serverless Webhook / Google Apps Script (100% propio en cuenta Gmail)
# PUBLIC_CONTACT_WEBHOOK_URL=https://script.google.com/macros/s/tu_deployment_id/exec

# Opción D: EmailJS (https://www.emailjs.com/)
# PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
# PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key_emailjs
