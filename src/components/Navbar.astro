---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import BrandSignature from './BrandSignature.astro';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { navigation, profile } = await getPortfolioContent(locale);
const navItems = navigation.items;
const { languageSwitcher } = navigation;

const navIconMap: Record<string, 'home' | 'user' | 'code' | 'terminal' | 'briefcase' | 'layers' | 'message'> = {
  home: 'home',
  about: 'user',
  skills: 'code',
  projects: 'terminal',
  experiences: 'briefcase',
  services: 'layers',
  contact: 'message',
};
---

<!-- START NAVBAR -->
<header>
  <nav
    class="navbar-custom fixed top-0 left-0 right-0"
    id="navbar"
    aria-label={navigation.ariaLabel}
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex min-h-[72px] items-center justify-between">
        <!-- Brand Signature Logo (Natural Cursive Rubric + Avatar) -->
        <a
          class="navbar-brand-logo flex items-center"
          href={`#${navItems[0]?.id || 'home'}`}
          aria-label={navigation.brandAriaLabel}
        >
          <BrandSignature
            avatarImage={profile.avatarImage}
            avatarAlt={profile.avatarAlt}
            subtitle={locale === 'en' ? 'Backend & Full Stack' : 'Backend & Full Stack'}
          />
        </a>

        <!-- Desktop Navigation Links (Clean SVG Icons + Uppercase Labels + Active Block) -->
        <ul class="hidden lg:flex items-stretch mx-auto" id="navbar-navlist">
          {
            navItems.map((item, index) => {
              const iconName = navIconMap[item.id] || 'home';
              return (
                <li class="flex">
                  <a
                    href={`#${item.id}`}
                    data-nav-link={item.id}
                    class:list={['nav-item-link', { active: index === 0 }]}
                  >
                    <Icon name={iconName} size={18} class="nav-icon mb-1" />
                    <span class="nav-label">{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <!-- Right Controls: Phone + Language Switcher (ES/EN) + Theme Switcher + Mobile Hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href={`tel:${profile.phoneClean}`}
            class="hidden xl:inline-flex items-center gap-1.5 text-white hover:text-gold transition-colors text-sm font-semibold tracking-wide"
            aria-label={profile.phone}
          >
            <Icon name="phone" size={15} class="text-gold" />
            <span class="text-sm font-normal tracking-wider">{profile.phone}</span>
          </a>

          <!-- Zero-friction Language Switcher (100% Solid Pill - No Magnetic Delay) -->
          <a
            href={withBase(languageSwitcher.targetHref)}
            data-lang-switch
            class="nav-control-btn inline-flex h-11 items-center justify-center gap-1.5 rounded-full px-3.5 text-xs font-semibold uppercase tracking-widest cursor-pointer select-none"
            aria-label={languageSwitcher.ariaLabel}
            title={languageSwitcher.title}
          >
            <Icon name="globe" size={16} class="text-gold shrink-0" />
            <span>{languageSwitcher.currentCode}</span>
            <span class="opacity-60" aria-hidden="true">/</span>
            <span class="text-gold">{languageSwitcher.targetCode}</span>
          </a>

          <!-- Light / Dark Mode Switcher (SVG Icons - 100% Solid) -->
          <button
            type="button"
            id="theme-toggle-btn"
            data-magnetic
            class="nav-control-btn inline-flex h-11 w-11 items-center justify-center rounded-full cursor-pointer"
            aria-label={navigation.themeToggleAriaLabel}
            title={navigation.themeToggleTitle}
          >
            <span id="theme-icon-moon" class="inline-flex">
              <Icon name="moon" size={18} />
            </span>
            <span id="theme-icon-sun" class="hidden text-gold">
              <Icon name="sun" size={18} />
            </span>
          </button>

          <!-- Mobile Menu Button (Strictly hidden on desktop: max-lg:inline-flex lg:hidden) -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="nav-control-btn max-lg:inline-flex lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-lg cursor-pointer"
            aria-controls="navbarCollapse"
            aria-expanded="false"
            aria-label={navigation.mobileMenuAriaLabel}
          >
            <span id="mobile-icon-bars" class="inline-flex">
              <Icon name="menu" size={22} />
            </span>
            <span id="mobile-icon-close" class="hidden">
              <Icon name="close" size={22} />
            </span>
          </button>
        </div>
      </div>

      <!-- Mobile Collapsible Navigation (Strictly hidden on desktop) -->
      <div
        id="navbarCollapse"
        class="hidden lg:hidden border-t-2 border-[#252a37] bg-[#14171f] pb-4 pt-2"
        aria-hidden="true"
      >
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            navItems.map((item, index) => {
              const iconName = navIconMap[item.id] || 'home';
              return (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-nav-link={item.id}
                    class:list={['nav-item-link rounded-lg py-3', { active: index === 0 }]}
                  >
                    <Icon name={iconName} size={18} class="nav-icon mb-1" />
                    <span class="nav-label">{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="mt-3 pt-3 border-t-2 border-[#252a37] flex flex-wrap items-center justify-center gap-4 sm:hidden">
          <a
            href={`tel:${profile.phoneClean}`}
            class="inline-flex items-center gap-2 text-white text-sm font-semibold"
          >
            <Icon name="phone" size={16} class="text-gold" />
            <span>{profile.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
<!-- END NAVBAR -->

<script>
  function setupNavbar() {
    const navbar = document.getElementById('navbar');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('navbarCollapse');
    const iconBars = document.getElementById('mobile-icon-bars');
    const iconClose = document.getElementById('mobile-icon-close');
    const themeBtn = document.getElementById('theme-toggle-btn');
    const moonIcon = document.getElementById('theme-icon-moon');
    const sunIcon = document.getElementById('theme-icon-sun');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const langLinks = document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]');

    // Preserve active section hash when switching ES <-> EN
    langLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.location.hash) {
          const baseHref = link.getAttribute('href')?.split('#')[0] || '';
          if (baseHref) {
            link.setAttribute('href', `${baseHref}${window.location.hash}`);
          }
        }
      });
    });

    // Sync theme icon with current data-theme
    function syncThemeIcon() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      if (moonIcon && sunIcon) {
        if (current === 'dark') {
          moonIcon.classList.add('hidden');
          sunIcon.classList.remove('hidden');
        } else {
          moonIcon.classList.remove('hidden');
          sunIcon.classList.add('hidden');
        }
      }
    }
    syncThemeIcon();

    // Toggle Light/Dark Theme
    themeBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('user-theme', next);
      } catch (e) {}
      syncThemeIcon();
    });

    // Accessible Mobile Menu Toggle with Escape, click-outside, and resize cleanup
    function setMobileMenuOpen(open: boolean) {
      if (!mobileBtn || !mobileMenu) return;
      mobileBtn.setAttribute('aria-expanded', String(open));
      mobileMenu.classList.toggle('hidden', !open);
      mobileMenu.setAttribute('aria-hidden', String(!open));
      if (iconBars && iconClose) {
        iconBars.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
      }
    }

    mobileBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      setMobileMenuOpen(!isExpanded);
    });

    // Close on link click
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          setMobileMenuOpen(false);
        }
      });
    });

    // Close on Escape key press and refocus button
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileBtn?.getAttribute('aria-expanded') === 'true') {
        setMobileMenuOpen(false);
        mobileBtn.focus();
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (
        mobileBtn?.getAttribute('aria-expanded') === 'true' &&
        navbar &&
        !navbar.contains(e.target as Node)
      ) {
        setMobileMenuOpen(false);
      }
    });

    // Auto-close on viewport resize to desktop
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth >= 1024 && mobileBtn?.getAttribute('aria-expanded') === 'true') {
          setMobileMenuOpen(false);
        }
      },
      { passive: true }
    );

    // Sticky Navbar state using passive scroll
    const updateSticky = () => {
      if (!navbar) return;
      if (window.scrollY > 40) {
        navbar.classList.add('nav-sticky');
      } else {
        navbar.classList.remove('nav-sticky');
      }
    };
    updateSticky();
    window.addEventListener('scroll', updateSticky, { passive: true });

    // Deterministic Scrollspy based on viewport scroll position
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    const updateScrollSpy = () => {
      const scrollPos = window.scrollY + 240;
      let currentId = 'home';
      if (window.scrollY >= 120) {
        for (const section of sections) {
          if (section.offsetTop <= scrollPos) {
            currentId = section.id;
          }
        }
      }
      navLinks.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-link') === currentId;
        link.classList.toggle('active', isMatch);
      });
    };
    updateScrollSpy();
    window.addEventListener('scroll', updateScrollSpy, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', setupNavbar);
</script>
