---
import '../styles/global.css';
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import InteractiveCursor from '../components/InteractiveCursor.astro';

interface Props {
  locale?: PortfolioLocale;
  title?: string;
  description?: string;
}

const { locale = 'es' } = Astro.props;
const content = await getPortfolioContent(locale);
const { seo, profile, about } = content;

const canonicalUrl = seo.siteUrl;
const ogImageUrl = new URL(seo.ogImage.replace(/^\//, ''), 'https://lhachas.github.io/portfolio/').toString();

const {
  title = seo.title,
  description = seo.description,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalUrl}#profilepage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: seo.language,
      dateModified: seo.dateModified,
      mainEntity: {
        '@id': `${canonicalUrl}#person`,
      },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl}#person`,
      name: profile.name,
      givenName: seo.schemaOrg.givenName,
      familyName: seo.schemaOrg.familyName,
      jobTitle: seo.schemaOrg.jobTitle,
      description: about.lead,
      url: canonicalUrl,
      image: ogImageUrl,
      email: `mailto:${profile.email}`,
      telephone: profile.phone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: seo.schemaOrg.addressLocality,
        addressCountry: seo.schemaOrg.addressCountry,
      },
      worksFor: {
        '@type': 'Organization',
        name: seo.schemaOrg.worksFor,
      },
      alumniOf: seo.schemaOrg.alumniOf.map((inst) => ({
        '@type': inst.type,
        name: inst.name,
      })),
      knowsLanguage: seo.schemaOrg.knowsLanguageCodes,
      sameAs: [
        profile.linkedin,
        profile.github,
        profile.facebook,
        profile.instagram,
      ],
      knowsAbout: about.coreStackPills,
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: seo.siteName,
      inLanguage: seo.language,
      publisher: {
        '@id': `${canonicalUrl}#person`,
      },
    },
  ],
};
---

<!doctype html>
<html lang={seo.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="keywords" content={seo.keywords} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content={seo.themeColor} />

    <!-- Security Meta Headers (CSP, Referrer-Policy, X-Content-Type-Options) -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://formspree.io https://api.emailjs.com https://script.google.com https://script.googleusercontent.com https://formsubmit.co https://cdn.jsdelivr.net; base-uri 'self'; form-action 'self' https://api.web3forms.com https://formspree.io https://formsubmit.co; object-src 'none'; upgrade-insecure-requests;"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Canonical URL, Bilingual hreflang & Sitemap -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={seo.language} href={canonicalUrl} />
    <link rel="alternate" hreflang={seo.alternateLanguage} href={seo.alternateUrl} />
    <link rel="alternate" hreflang="x-default" href="https://lhachas.github.io/portfolio/" />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />

    <!-- Open Graph / LinkedIn & Recruiter Preview -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:locale:alternate" content={seo.alternateLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={withBase(seo.favicon)} />

    <!-- Preload Critical Above-the-Fold Assets -->
    <link rel="preload" as="image" href={withBase(profile.profilePhoto)} />

    <!-- Unified Typography via Google Fonts (Oswald + Victor Mono, zero source-map CSP overhead) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Victor+Mono:ital,wght@0,400;0,600;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Original Icon Fonts (Icofont & Technology Icons) -->
    <link rel="stylesheet" href={withBase('/assets/css/plugins/icofont.css')} />
    <link rel="stylesheet" href={withBase('/assets/css/plugins/technology-icons.css')} />

    <!-- Structured Data (Schema.org ProfilePage + Person + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Flash-Free Theme & Strictly Validated Accent Propagation -->
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var urlTheme = params.get('theme');
          var savedTheme = urlTheme || localStorage.getItem('user-theme');
          var theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : 'light';
          document.documentElement.setAttribute('data-theme', theme);

          var validHex = /^#[0-9a-fA-F]{6}$/;
          var savedAccent = localStorage.getItem('user-accent-hex') || '';
          var savedAccentHover = localStorage.getItem('user-accent-hover') || '';
          if (validHex.test(savedAccent) && validHex.test(savedAccentHover)) {
            var r = parseInt(savedAccent.slice(1, 3), 16);
            var g = parseInt(savedAccent.slice(3, 5), 16);
            var b = parseInt(savedAccent.slice(5, 7), 16);
            var yiq = (r * 299 + g * 587 + b * 114) / 1000;
            var onAccent = yiq >= 150 ? '#14171f' : '#ffffff';

            var root = document.documentElement.style;
            root.setProperty('--brand-gold', savedAccent);
            root.setProperty('--brand-gold-hover', savedAccentHover);
            root.setProperty('--brand-on-gold', onAccent);
            root.setProperty('--brand-primary', savedAccent);
            root.setProperty('--brand-primary-hover', savedAccentHover);
            root.setProperty('--brand-on-primary', onAccent);
            root.setProperty('--title-icon-color', savedAccent);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="antialiased">
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10001] focus:rounded-full focus:px-5 focus:py-2.5 focus:font-medium"
      style="background-color: var(--brand-gold); color: var(--brand-on-gold);"
    >
      {seo.skipToContentLabel}
    </a>

    <InteractiveCursor />

    <slot />

    <!-- Global Scroll-Reveal & Skill Progress Bar Observer -->
    <script>
      function initObservers() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. Reveal elements on scroll
        const revealEls = document.querySelectorAll('.reveal');
        if (prefersReducedMotion) {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  revealObserver.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );
          revealEls.forEach((el) => revealObserver.observe(el));
        }

        // 2. Animate skill progress bars when entering viewport
        const progressBars = document.querySelectorAll<HTMLElement>('.progres[data-value]');
        const skillObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const bar = entry.target as HTMLElement;
                const targetWidth = bar.getAttribute('data-value') || '0%';
                bar.style.width = targetWidth;
                skillObserver.unobserve(bar);
              }
            });
          },
          { threshold: 0.2 }
        );
        progressBars.forEach((bar) => skillObserver.observe(bar));
      }

      document.addEventListener('DOMContentLoaded', initObservers);
    </script>
  </body>
</html>
