    "preview": "astro preview",
    "astro": "astro",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts HeroCinematic public/assets/video/hero-cinematic.mp4",
    "remotion:still": "remotion still remotion/index.ts HeroCinematicPoster public/assets/video/hero-cinematic-poster.png"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.531",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.531",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  }
