---
import { getPortfolioContent, type PortfolioLocale } from '../data/portfolio';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { experiencesSection } = await getPortfolioContent(locale);
const experiencesData = experiencesSection.items;
---

<!-- START EXPERIENCES -->
<section class="section th-secondary experiences" id="experiences" aria-labelledby="experiences-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title Header (Preserves .title-icon + .title + .title-subtitle) -->
    <div class="text-center reveal">
      <div class="title-icon inline-flex items-center justify-center">
        <Icon name="briefcase" size={30} />
      </div>
      <h2 id="experiences-heading" class="title">
        {experiencesSection.titlePrefix} <span class="font-medium">{experiencesSection.titleHighlight}</span>
      </h2>
      <p class="txt-primary mt-3 title-subtitle mx-auto">
        {experiencesSection.subtitle}
      </p>
    </div>

    <!-- Quick Recruiter View Toggle -->
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3 reveal">
      <button
        type="button"
        id="toggle-all-achievements"
        data-expanded="true"
        data-compact-label={experiencesSection.toggleCompactLabel}
        data-detailed-label={experiencesSection.toggleDetailedLabel}
        class="inline-flex min-h-[42px] items-center gap-2 rounded-full px-5 py-2 text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer hover:border-gold active:scale-[0.97]"
        style="background-color: var(--th-secondary); border: 2px solid var(--card-border); color: var(--heading-color);"
      >
        <Icon name="layers" size={15} class="text-gold shrink-0 inline-block" />
        <span id="toggle-all-label">{experiencesSection.toggleCompactLabel}</span>
      </button>
    </div>

    <!-- Redesigned Solid Minimalist Interconnected Timeline (6 Distinct Non-Monotonous Stage Palettes) -->
    <div class="mt-10">
      <div class="main-timeline" id="experiences-timeline">
        <!-- Continuous Central Vertical Spine Connecting All 6 Stages -->
        <div class="main-timeline-track" aria-hidden="true">
          <div id="timeline-spine-progress" class="main-timeline-progress"></div>
        </div>

        {
          experiencesData.map((exp, idx) => {
            const expSlots = [
              'var(--accent-1)',
              'var(--accent-3)',
              'var(--accent-4)',
              'var(--accent-2)',
              'var(--accent-5)',
              'var(--accent-6)',
            ];
            const resolvedColor = expSlots[idx % expSlots.length];
            const resolvedTextColor = resolvedColor;
            const headerTextColor = '#ffffff';
            return (
              <article
                class="timeline reveal"
                style={`--timeline-color: ${resolvedColor}; --card-accent: ${resolvedColor}; --timeline-text-color: ${resolvedTextColor}; --year-step-text: ${headerTextColor};`}
              >
                <!-- 100% Solid Minimalist Stage Card Connected to Central Spine -->
                <div
                  class="timeline-content"
                  style={`--timeline-color: ${resolvedColor}; --card-accent: ${resolvedColor};`}
                >
                  <!-- Solid Stage Header Bar with Harmonized Medallions & Badges -->
                  <header
                    class="exp-card-header"
                    style={`background-color: ${resolvedColor};`}
                  >
                    <div class="exp-header-badges-group">
                      <span class="exp-step-badge" aria-label={`Etapa ${exp.stepNumber}`}>
                        {exp.stepNumber}
                      </span>
                      <span class="exp-domain-badge">
                        <Icon name="briefcase" size={13} class="shrink-0 inline-block" />
                        <span>{exp.clientOrDomain}</span>
                      </span>
                    </div>

                    <span class="exp-date-badge">
                      <Icon name="calendar" size={13} class="shrink-0 inline-block" />
                      <span>{exp.date}</span>
                    </span>
                  </header>

                  <!-- Solid Inner Content Body -->
                  <div class="inner-content">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <span class="exp-company-accent text-sm uppercase tracking-wider font-semibold">
                        {exp.company}
                      </span>
                      <span
                        class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium"
                        style="background-color: var(--th-primary); border: 1.5px solid var(--card-border); color: var(--pill-text);"
                      >
                        <Icon name="map-pin" size={12} class="shrink-0 inline-block" style={`color: ${resolvedColor};`} />
                        <span>{exp.location}</span>
                      </span>
                    </div>

                    <h3 class="card-title !text-[1.3rem]">
                      {exp.title}
                    </h3>

                    <p class="body-copy txt-primary mt-2">
                      {exp.summary}
                    </p>

                    <!-- Audited 2026 CV Highlights in Solid Stage-Accented Sub-Cards -->
                    <div class="exp-achievements mt-4 pt-3.5 border-t-2 space-y-2.5" style="border-color: var(--card-border);">
                      {
                        exp.highlights.map((item) => (
                          <div class="exp-highlight-card detail-copy">
                            <strong class="exp-highlight-label">
                              {item.label}:
                            </strong>{' '}
                            <span class="font-light txt-primary">{item.text}</span>
                          </div>
                        ))
                      }
                    </div>

                    <!-- Footer: Unified Portfolio Tech Pills (.tech-pill System) -->
                    <div class="mt-4 pt-2 flex flex-wrap gap-1.5" aria-label="Tecnologías utilizadas">
                      {
                        exp.technologies.map((tech) => (
                          <span
                            class="tech-pill"
                            style={`--card-accent: ${resolvedColor};`}
                          >
                            {tech}
                          </span>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>

  <!-- Original Top-Anchored SVG Wave Divider (Hangs downward from #projects into #experiences) -->
  <svg
    class="wave"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</section>
<!-- END EXPERIENCES -->

<style>
  .exp-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding: 12px 18px;
    border-bottom: 2px solid var(--timeline-color, var(--brand-gold));
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .exp-header-badges-group {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Universal High-Contrast Harmonious White Badges inside the Colored Stage Header */
  .exp-step-badge {
    display: inline-flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-size: 0.825rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    background-color: #ffffff !important;
    color: var(--timeline-color) !important;
    border: 2px solid #ffffff !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.14);
    flex-shrink: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .exp-step-badge:hover {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.22);
  }

  .exp-domain-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: #ffffff !important;
    color: #0f172a !important;
    border: 1.5px solid #ffffff !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .exp-domain-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
  }

  .exp-domain-badge span {
    color: #0f172a !important;
    font-weight: 700;
  }

  .exp-domain-badge svg,
  .exp-domain-badge i {
    color: var(--timeline-color) !important;
  }

  .exp-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background-color: #ffffff !important;
    color: #0f172a !important;
    border: 1.5px solid #ffffff !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease;
  }

  .exp-date-badge:hover {
    transform: translateY(-1px);
  }

  .exp-date-badge span {
    color: #0f172a !important;
    font-weight: 700;
  }

  .exp-date-badge svg,
  .exp-date-badge i {
    color: var(--timeline-color) !important;
  }
</style>

<script is:inline>
  (() => {
    const toggleBtn = document.getElementById('toggle-all-achievements');
    const toggleLabel = document.getElementById('toggle-all-label');
    const achievementBlocks = document.querySelectorAll('.exp-achievements');

    toggleBtn?.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('data-expanded') === 'true';
      const nextState = !isExpanded;
      toggleBtn.setAttribute('data-expanded', nextState ? 'true' : 'false');

      achievementBlocks.forEach((block) => {
        block.classList.toggle('hidden', !nextState);
      });

      if (toggleLabel) {
        const compactLabel = toggleBtn.getAttribute('data-compact-label') || '';
        const detailedLabel = toggleBtn.getAttribute('data-detailed-label') || '';
        toggleLabel.textContent = nextState ? compactLabel : detailedLabel;
      }
    });

    // Scroll-driven timeline spine progress (respecting prefers-reduced-motion)
    const timelineEl = document.getElementById('experiences-timeline');
    const spineProgress = document.getElementById('timeline-spine-progress');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (timelineEl && spineProgress && !prefersReducedMotion) {
      let ticking = false;
      const updateTimelineProgress = () => {
        const rect = timelineEl.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const startOffset = viewportHeight * 0.78;
        const totalDistance = Math.max(1, rect.height - viewportHeight * 0.25);
        const scrolled = startOffset - rect.top;
        const ratio = Math.min(1, Math.max(0.08, scrolled / totalDistance));
        spineProgress.style.transform = `scaleY(${ratio.toFixed(3)})`;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(updateTimelineProgress);
            ticking = true;
          }
        },
        { passive: true }
      );
      window.addEventListener('resize', updateTimelineProgress, { passive: true });
      updateTimelineProgress();
    }
  })();
</script>
