---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { contactSection, profile } = await getPortfolioContent(locale);
const { form, cvCard } = contactSection;

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '7da1b53c-7213-4531-b543-b3cffee744e5';
const emailJsServiceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || '';
const emailJsTemplateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || '';
const emailJsPublicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || '';
const webhookEndpoint = import.meta.env.PUBLIC_CONTACT_WEBHOOK_URL || '';
const defaultAjaxEndpoint = `https://formsubmit.co/ajax/${profile.email}`;
---

<!-- START CONTACT -->
<section class="section th-primary" id="contact" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title Header (Preserves .title-icon + .title + .title-subtitle) -->
    <div class="text-center reveal">
      <i class={`icofont ${contactSection.sectionIcon} title-icon`} aria-hidden="true"></i>
      <h2 id="contact-heading" class="title">
        {contactSection.titlePrefix} <span class="font-medium">{contactSection.titleHighlight}</span>
      </h2>
      <p class="txt-primary mt-3 title-subtitle mx-auto">
        {contactSection.subtitle}
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pt-2">
      <!-- Left Column: Direct Contact Channels with Strict 100% Solid Official Brand Colors -->
      <div class="lg:col-span-5 space-y-3.5 reveal">
        <h3 class="card-title mb-3">
          {contactSection.channelsTitlePrefix} <span class="text-gold">{contactSection.channelsTitleHighlight}</span>
        </h3>

        {
          contactSection.channels.map((channel) => {
            const isBrandAccent = channel.color.toLowerCase() === '#cdb30c';
            const resolvedColor = isBrandAccent ? 'var(--brand-gold)' : channel.color;
            const iconTextStyle = isBrandAccent ? 'color: var(--brand-on-gold);' : '';
            const extraBorderClass = channel.id === 'github' ? 'border-2 border-[#484f58]' : '';

            return channel.href ? (
              <a
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
                class="contact-channel-card"
                style={`--channel-color: ${resolvedColor};`}
                data-cursor-label={channel.cursorLabel}
              >
                <span class={`contact-channel-icon ${extraBorderClass}`} style={iconTextStyle} aria-hidden="true">
                  <i class={`icofont ${channel.icon}`}></i>
                </span>
                <div class="min-w-0">
                  <span class="label-c block">{channel.label}</span>
                  <span class="detail-copy block truncate font-normal">{channel.value}</span>
                </div>
              </a>
            ) : (
              <div
                class="contact-channel-card"
                style={`--channel-color: ${resolvedColor};`}
              >
                <span class="contact-channel-icon" style={iconTextStyle} aria-hidden="true">
                  <i class={`icofont ${channel.icon}`}></i>
                </span>
                <div class="min-w-0">
                  <span class="label-c block">{channel.label}</span>
                  <span class="detail-copy block font-normal">{channel.value}</span>
                </div>
              </div>
            );
          })
        }

        <!-- Direct Official 2026 CV Download Card (100% Solid Surface - Active Locale PDF Only) -->
        <div class="spotlight-card rounded-2xl p-5 mt-4" style="background-color: var(--th-secondary); border-color: var(--card-border);">
          <div class="flex items-center justify-between gap-2">
            <span class="label-c block">{cvCard.title}</span>
            <span class="rounded-md bg-[#0e3d65] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold border border-gold">
              {profile.cvPrimary.badge}
            </span>
          </div>
          <p class="detail-copy mt-1.5">
            {cvCard.description}
          </p>
          <div class="mt-3.5">
            <a
              href={withBase(profile.cvPrimary.url)}
              target="_blank"
              rel="noopener noreferrer"
              download={profile.cvPrimary.filename}
              data-magnetic
              data-cv-lang={profile.cvPrimary.langCode}
              aria-label={profile.cvPrimary.ariaLabel}
              class="btn-cv-solid w-full justify-center whitespace-nowrap"
            >
              <i class={`icofont ${profile.cvPrimary.icon} text-base`} aria-hidden="true"></i>
              <span>{profile.cvPrimary.labelContact}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Real Functional Email Contact Form (100% Solid + XSS & Rate-Limit Hardened) -->
      <div class="lg:col-span-7 reveal">
        <div class="spotlight-card rounded-2xl p-6 sm:p-8" style="background-color: var(--th-secondary); border-color: var(--card-border);">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
            <div>
              <h3 class="card-title">
                {form.titlePrefix} <span class="text-gold">{form.titleHighlight}</span>
              </h3>
              <p class="detail-copy mt-1">
                {form.subtitlePrefix} (<strong>{profile.email}</strong>).
              </p>
            </div>
            <span class="tech-pill">
              <span class="status-pulse-dot" aria-hidden="true"></span>
              <span>{form.activeStatusBadge}</span>
            </span>
          </div>

          <!-- Quick Topic Selector Chips for Recruiters -->
          <div class="mb-5">
            <span class="label-c block mb-2">{form.quickTopicsLabel}</span>
            <div class="flex flex-wrap gap-2" role="group" aria-label={form.quickTopicsAriaLabel}>
              {
                form.quickTopics.map((topic) => (
                  <button
                    type="button"
                    data-quick-topic={topic}
                    class="tech-pill cursor-pointer transition-colors"
                  >
                    <i class="icofont icofont-plus-circle text-gold" aria-hidden="true"></i>
                    <span>{topic.split(' (')[0]}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <form
            id="contact-form"
            action={formspreeEndpoint || 'https://api.web3forms.com/submit'}
            method="POST"
            data-formspree={formspreeEndpoint}
            data-web3forms={web3FormsKey}
            data-emailjs-service={emailJsServiceId}
            data-emailjs-template={emailJsTemplateId}
            data-emailjs-key={emailJsPublicKey}
            data-webhook={webhookEndpoint}
            data-default-endpoint={defaultAjaxEndpoint}
            data-recipient={profile.email}
            data-whatsapp-base={profile.whatsappDirectBase}
            data-i18n={JSON.stringify(form)}
            novalidate
          >
            <!-- Multi-provider Anti-spam Honeypots (Web3Forms, Formspree, FormSubmit) -->
            <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />

            <!-- Status Feedback Banner (100% Solid Theme-Adaptive Surface) -->
            <div
              id="contact-feedback"
              class="mb-5 hidden rounded-2xl border-2 px-4 py-3.5 text-sm font-normal"
              style="background-color: var(--th-primary); color: var(--txt-primary);"
              role="status"
              aria-live="polite"
              tabindex="-1"
            ></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="label-c block mb-2">
                  {form.fields.nameLabel} <span class="text-gold" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  maxlength="100"
                  aria-invalid="false"
                  aria-describedby="error-name"
                  placeholder={form.fields.namePlaceholder}
                  class="form-control-pill"
                  style="background-color: var(--th-primary);"
                />
                <p id="error-name" class="mt-1.5 hidden text-xs text-[#dc2626] font-medium" role="alert"></p>
              </div>

              <div>
                <label for="contact-email" class="label-c block mb-2">
                  {form.fields.emailLabel} <span class="text-gold" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="120"
                  spellcheck="false"
                  aria-invalid="false"
                  aria-describedby="error-email"
                  placeholder={form.fields.emailPlaceholder}
                  class="form-control-pill"
                  style="background-color: var(--th-primary);"
                />
                <p id="error-email" class="mt-1.5 hidden text-xs text-[#dc2626] font-medium" role="alert"></p>
              </div>
            </div>

            <div class="mt-4">
              <label for="contact-subject" class="label-c block mb-2">
                {form.fields.subjectLabel} <span class="text-gold" aria-hidden="true">*</span>
              </label>
              <input
                id="contact-subject"
                name="subject"
                type="text"
                required
                minlength="3"
                maxlength="160"
                aria-invalid="false"
                aria-describedby="error-subject"
                placeholder={form.fields.subjectPlaceholder}
                class="form-control-pill"
                style="background-color: var(--th-primary);"
              />
              <p id="error-subject" class="mt-1.5 hidden text-xs text-[#dc2626] font-medium" role="alert"></p>
            </div>

            <div class="mt-4">
              <label for="contact-comments" class="label-c block mb-2">
                {form.fields.messageLabel} <span class="text-gold" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-comments"
                name="message"
                rows="5"
                required
                minlength="10"
                maxlength="2500"
                aria-invalid="false"
                aria-describedby="error-comments"
                placeholder={form.fields.messagePlaceholder}
                class="form-control-pill"
                style="background-color: var(--th-primary);"
              ></textarea>
              <p id="error-comments" class="mt-1.5 hidden text-xs text-[#dc2626] font-medium" role="alert"></p>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
              <a
                href={profile.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-social-pill whatsapp"
                data-magnetic
                data-cursor-label={form.whatsappCtaCursorLabel}
              >
                <i class="icofont icofont-whatsapp" aria-hidden="true"></i>
                <span>{form.whatsappCtaLabel}</span>
              </a>

              <button
                type="submit"
                id="contact-submit-btn"
                class="btn-brand btn-theme-primary"
                data-cursor-label={form.submitCursorLabel}
              >
                <span id="contact-submit-text">{form.submitLabel}</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Original Top-Anchored SVG Wave Divider (.wv-primary hangs downward from #services into #contact) -->
  <svg
    class="wave wv-primary"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</section>
<!-- END CONTACT -->

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('contact-feedback');
    const submitBtn = document.getElementById('contact-submit-btn');
    const submitText = document.getElementById('contact-submit-text');
    const subjectInput = document.getElementById('contact-subject');
    const quickTopicBtns = document.querySelectorAll('[data-quick-topic]');
    const formLoadedAt = Date.now();

    if (!form || !feedback || !submitBtn || !submitText) return;

    const rawI18n = form.getAttribute('data-i18n');
    const i18n = rawI18n ? JSON.parse(rawI18n) : {};
    const fieldsI18n = i18n.fields || {};

    // HTML Entity Escaping to prevent DOM XSS (CWE-79)
    const escapeHtml = (unsafe) =>
      String(unsafe || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    // 1. Quick-Topic Chips populate subject input
    quickTopicBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const topic = btn.getAttribute('data-quick-topic');
        if (subjectInput && topic) {
          subjectInput.value = topic;
          subjectInput.setAttribute('aria-invalid', 'false');
          const errSub = document.getElementById('error-subject');
          if (errSub) errSub.classList.add('hidden');
          subjectInput.focus();
        }
      });
    });

    // 2. Helper for inline field validation
    const setFieldError = (inputId, errorId, message) => {
      const inputEl = document.getElementById(inputId);
      const errorEl = document.getElementById(errorId);
      if (!inputEl || !errorEl) return;
      if (message) {
        inputEl.setAttribute('aria-invalid', 'true');
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      } else {
        inputEl.setAttribute('aria-invalid', 'false');
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }
    };

    ['contact-name', 'contact-email', 'contact-subject', 'contact-comments'].forEach((id) => {
      const el = document.getElementById(id);
      const errId = id.replace('contact-', 'error-');
      el?.addEventListener('input', () => setFieldError(id, errId, ''));
    });

    const fetchWithTimeout = async (url, options, timeoutMs = 8000) => {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      try {
        return await fetch(url, { ...options, signal: controller.signal });
      } finally {
        clearTimeout(timer);
      }
    };

    // 3. Multi-Provider Real Email Submission with Anti-Automation Rate Limiting & XSS Sanitization
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const honey = String(formData.get('_honey') || '').trim();
      const gotcha = String(formData.get('_gotcha') || '').trim();
      const botcheck = formData.get('botcheck');
      if (honey || gotcha || botcheck) return; // Silently drop bot submissions

      const now = Date.now();
      if (now - formLoadedAt < 800) return; // Block instant automated script posts

      // Client-side rate limiting (45s cooldown per session)
      try {
        const lastSent = Number(sessionStorage.getItem('portfolio_last_contact_ts') || '0');
        if (lastSent && now - lastSent < 45000) {
          const waitSec = Math.ceil((45000 - (now - lastSent)) / 1000);
          feedback.className =
            'mb-5 rounded-2xl border-2 border-[#d97706] px-4 py-3 text-sm font-medium';
          feedback.style.backgroundColor = 'var(--th-primary)';
          feedback.style.color = 'var(--txt-primary)';
          feedback.textContent = `${i18n.rateLimitMessagePrefix || ''} ${waitSec} ${i18n.rateLimitMessageSuffix || ''}`.trim();
          feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }
      } catch (err) {}

      const name = String(formData.get('name') || '').trim().slice(0, 100);
      const email = String(formData.get('email') || '').trim().slice(0, 120);
      const subject = String(formData.get('subject') || '').trim().slice(0, 160);
      const message = String(formData.get('message') || '').trim().slice(0, 2500);
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      let firstInvalidId = '';
      if (name.length < 2) {
        setFieldError('contact-name', 'error-name', fieldsI18n.nameError || '');
        if (!firstInvalidId) firstInvalidId = 'contact-name';
      }
      if (!emailRegex.test(email)) {
        setFieldError('contact-email', 'error-email', fieldsI18n.emailError || '');
        if (!firstInvalidId) firstInvalidId = 'contact-email';
      }
      if (subject.length < 3) {
        setFieldError('contact-subject', 'error-subject', fieldsI18n.subjectError || '');
        if (!firstInvalidId) firstInvalidId = 'contact-subject';
      }
      if (message.length < 10) {
        setFieldError('contact-comments', 'error-comments', fieldsI18n.messageError || '');
        if (!firstInvalidId) firstInvalidId = 'contact-comments';
      }

      if (firstInvalidId) {
        feedback.className =
          'mb-5 rounded-2xl border-2 border-[#dc2626] px-4 py-3 text-sm font-medium text-[#dc2626]';
        feedback.style.backgroundColor = 'var(--th-primary)';
        feedback.textContent = i18n.validationBannerError || '';
        document.getElementById(firstInvalidId)?.focus();
        return;
      }

      submitBtn.setAttribute('disabled', 'true');
      submitText.textContent = i18n.submitLoadingLabel || '';
      feedback.classList.add('hidden');

      const formspreeUrl = form.getAttribute('data-formspree') || '';
      const web3formsKey = form.getAttribute('data-web3forms') || '';
      const emailjsService = form.getAttribute('data-emailjs-service') || '';
      const emailjsTemplate = form.getAttribute('data-emailjs-template') || '';
      const emailjsKey = form.getAttribute('data-emailjs-key') || '';
      const webhookUrl = form.getAttribute('data-webhook') || '';
      const defaultEndpoint = form.getAttribute('data-default-endpoint') || '';
      const recipient = form.getAttribute('data-recipient') || '';
      const whatsappBase = form.getAttribute('data-whatsapp-base') || '';

      const safeName = escapeHtml(name);
      const safeEmail = escapeHtml(email);
      const safeRecipient = escapeHtml(recipient);
      const formattedSubject = `[Portafolio LHachaS] ${subject}`;

      try {
        let delivered = false;

        if (web3formsKey) {
          const response = await fetchWithTimeout('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: web3formsKey,
              name,
              from_name: name,
              email,
              replyto: email,
              subject: formattedSubject,
              message,
            }),
          });
          const data = await response.json().catch(() => ({}));
          delivered = Boolean(response.ok && data.success !== false);
        } else if (formspreeUrl && formspreeUrl.startsWith('https://formspree.io/')) {
          const response = await fetchWithTimeout(formspreeUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              name,
              email,
              _replyto: email,
              subject: formattedSubject,
              message,
            }),
          });
          const data = await response.json().catch(() => ({}));
          delivered = Boolean(response.ok && !data.error);
        } else if (emailjsService && emailjsTemplate && emailjsKey) {
          const response = await fetchWithTimeout('https://api.emailjs.com/api/v1.0/email/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              service_id: emailjsService,
              template_id: emailjsTemplate,
              user_id: emailjsKey,
              template_params: {
                from_name: name,
                reply_to: email,
                to_email: recipient,
                subject: formattedSubject,
                message,
              },
            }),
          });
          delivered = Boolean(response.ok);
        } else if (webhookUrl && webhookUrl.startsWith('https://')) {
          const response = await fetchWithTimeout(webhookUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              name,
              email,
              recipient,
              subject: formattedSubject,
              message,
              sourceUrl: window.location.href,
            }),
          });
          delivered = Boolean(response.ok);
        } else if (defaultEndpoint) {
          const response = await fetchWithTimeout(defaultEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              name,
              email,
              _replyto: email,
              _subject: formattedSubject,
              subject,
              message,
              _url: window.location.href,
              _captcha: 'false',
              _template: 'table',
            }),
          });
          const data = await response.json().catch(() => ({}));
          delivered = Boolean(
            response.ok &&
              data.success !== 'false' &&
              data.success !== false &&
              !String(data.message || '').toLowerCase().includes('activation')
          );
        }

        if (delivered) {
          try {
            sessionStorage.setItem('portfolio_last_contact_ts', String(Date.now()));
          } catch (err) {}

          feedback.className =
            'mb-5 rounded-2xl border-2 border-[#059669] px-4 py-3.5 text-sm font-normal';
          feedback.style.backgroundColor = 'var(--th-primary)';
          feedback.style.color = 'var(--txt-primary)';
          feedback.innerHTML = `
            <div class="flex items-start gap-2.5">
              <i class="icofont icofont-check-circled text-lg mt-0.5 shrink-0 text-[#059669]" aria-hidden="true"></i>
              <div>
                <strong class="block font-medium" style="color: var(--txt-primary);">${escapeHtml(i18n.successTitlePrefix)} ${safeRecipient}!</strong>
                <span class="detail-copy">${escapeHtml(i18n.successBodyPrefix)} ${safeName}. ${escapeHtml(i18n.successBodyMiddle)} ${safeEmail}.</span>
              </div>
            </div>
          `;
          form.reset();
          feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          throw new Error('Direct delivery channel activated');
        }
      } catch (err) {
        const mailtoSubject = encodeURIComponent(formattedSubject);
        const mailtoBody = encodeURIComponent(`${name} (${email})\n\n${message}`);
        const mailtoHref = `mailto:${recipient}?subject=${mailtoSubject}&body=${mailtoBody}`;
        const waText = encodeURIComponent(`${name} (${email}) - ${subject}:\n\n${message}`);

        feedback.className =
          'mb-5 rounded-2xl border-2 border-gold px-4 py-3.5 text-sm font-normal';
        feedback.style.backgroundColor = 'var(--th-primary)';
        feedback.style.color = 'var(--txt-primary)';
        feedback.innerHTML = `
          <div>
            <strong class="block font-medium text-gold mb-1">${escapeHtml(i18n.fallbackTitle)}</strong>
            <p class="detail-copy mb-3">
              ${escapeHtml(i18n.fallbackDescriptionPrefix)} <strong>${safeRecipient}</strong>, ${escapeHtml(i18n.fallbackDescriptionSuffix)}
            </p>
            <div class="flex flex-wrap gap-2.5">
              <a id="direct-mailto-trigger" href="mailto:${safeRecipient}?subject=${mailtoSubject}&body=${mailtoBody}" class="btn-social-pill email !min-h-[36px] !py-1.5 !px-3.5 !text-xs">
                <i class="icofont icofont-envelope" aria-hidden="true"></i>
                <span>${escapeHtml(i18n.fallbackEmailButtonLabel)}</span>
              </a>
              <a href="${escapeHtml(whatsappBase)}?text=${waText}" target="_blank" rel="noopener noreferrer" class="btn-social-pill whatsapp !min-h-[36px] !py-1.5 !px-3.5 !text-xs">
                <i class="icofont icofont-whatsapp" aria-hidden="true"></i>
                <span>${escapeHtml(i18n.fallbackWhatsappButtonLabel)}</span>
              </a>
            </div>
          </div>
        `;
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        try {
          window.location.href = mailtoHref;
        } catch (openErr) {}
      } finally {
        submitBtn.removeAttribute('disabled');
        submitText.textContent = i18n.submitLabel || '';
      }
    });
  })();
</script>
