{
  "name": "portfolio-lhachas",
  "type": "module",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "astro sync",
    "verify:security": "node scripts/verify-build-security.mjs",
    "validate:content": "astro sync && tsc --noEmit && node scripts/verify-build-security.mjs",
