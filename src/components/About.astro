---
import { profileData, educationData, coursesData, withBase } from '../data/portfolio';
---

<!-- START ABOUT -->
<section class="section th-primary about" id="about" aria-labelledby="about-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title Header (Solid Architectural Medallion .title-icon) -->
    <div class="text-center reveal">
      <i class="icofont icofont-man-in-glasses title-icon" aria-hidden="true"></i>
      <h2 id="about-heading" class="title">
        Sobre <span class="font-medium">Mí</span>
      </h2>
      <p class="txt-primary mt-3 title-subtitle mx-auto">
        {profileData.aboutLead}
      </p>
    </div>

    <!-- Main 2-Column Content (Preserves circular profile photo + Full-Stack / Backend bio) -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Left Column: Circular Framed Profile Image -->
      <div class="lg:col-span-5 flex flex-col items-center reveal">
        <div class="iam-img-wrapper">
          <div class="iam-orbit-ring" aria-hidden="true"></div>
          <img
            class="iam-photo"
            src={withBase('/assets/images/iam-4.jpg')}
            alt="Fotografía profesional de Leonel Hacha Salazar - Senior Backend & Full-Stack Developer"
            width="345"
            height="345"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <!-- Experience Solid Badge (Zero Blur Shadow) -->
          <div
            class="absolute -bottom-3 right-2 rounded-full bg-[#14171f] border-2 border-[#cdb30c] px-4 py-1.5 text-white flex items-center gap-2"
            style="box-shadow: 0 4px 0 #090b10;"
          >
            <i class="icofont icofont-code-alt text-gold text-base" aria-hidden="true"></i>
            <span class="text-xs font-medium uppercase tracking-wider">
              {profileData.yearsExperience} Años Exp.
            </span>
          </div>
        </div>

        <!-- Languages & Location Quick Strip (100% Solid Non-Monotonous Pills) -->
        <div class="mt-7 flex flex-wrap items-center justify-center gap-2">
          <span class="tech-pill" style="--card-accent: #0e3d65;">
            <i class="icofont icofont-location-pin text-gold" aria-hidden="true"></i>
            <span>{profileData.location}</span>
          </span>
          {
            profileData.languages.map((lang) => (
              <span class="tech-pill" style="--card-accent: #0d9488;">
                <strong>{lang.name}:</strong> <span>{lang.level}</span>
              </span>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Senior Backend & Full-Stack Bio + Stack Pills + CTAs -->
      <div class="lg:col-span-7 reveal">
        <div class="features-desc">
          <h3 class="subsection-title">
            {profileData.aboutRoleTitle} <span class="font-medium">{profileData.aboutRoleHighlight}</span>
          </h3>

          {
            profileData.aboutParagraphs.map((paragraph) => (
              <p class="body-copy txt-primary mt-4 text-justify sm:text-left">
                {paragraph}
              </p>
            ))
          }

          <!-- Core Stack Pills -->
          <div class="mt-5">
            <span class="label-c block mb-2.5">Especialización Principal:</span>
            <div class="flex flex-wrap gap-2">
              {
                profileData.coreStackPills.map((tech, idx) => {
                  const accents = ['#2563eb', '#ea6a15', '#0d9488', '#7c3aed'];
                  const accent = accents[idx % accents.length];
                  return (
                    <span class="tech-pill" style={`--card-accent: ${accent};`}>
                      {tech}
                    </span>
                  );
                })
              }
            </div>
          </div>

          <!-- Action Buttons (Preserves Descargar CV + Contáctame + Official Social Brand Buttons) -->
          <div class="mt-7 flex flex-wrap items-center gap-3.5">
            <a
              href={profileData.cvBackendUrl}
              target="_blank"
              rel="noopener noreferrer"
              download="CV-Leonel-Hacha-Salazar-Backend-2026-ES.pdf"
              class="btn-brand btn-gold"
              data-cursor-label="PDF 2026"
            >
              <span>Descargar CV</span>
            </a>

            <a href="#contact" class="btn-brand btn-theme-primary" data-cursor-label="Contacto">
              <span>Contáctame</span>
            </a>

            <!-- Official LinkedIn Brand Button (#0A66C2) -->
            <a
              href={profileData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              data-cursor-label="LinkedIn"
              class="btn-social-pill linkedin"
            >
              <i class="icofont icofont-linkedin" aria-hidden="true"></i>
              <span>LinkedIn</span>
            </a>

            <!-- Official GitHub Brand Button (#24292F) -->
            <a
              href={profileData.github}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              data-cursor-label="GitHub"
              class="btn-social-pill github"
            >
              <i class="icofont icofont-github" aria-hidden="true"></i>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Redesigned Executive Education, Technical Training & Languages Cards (100% Solid Bento Architecture) -->
    <div class="mt-14 reveal">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          educationData.map((edu, idx) => (
            <article
              class="edu-card"
              style={`--edu-accent: ${edu.accentColor}; --reveal-delay: ${idx * 90}ms;`}
            >
              <div>
                <div class="flex items-start justify-between gap-3 mb-4">
                  <div class="inline-flex items-center gap-3">
                    <span class="edu-icon-badge" aria-hidden="true">
                      <i class={`icofont ${edu.icon}`}></i>
                    </span>
                    <div>
                      <span
                        class="block text-xs font-semibold uppercase tracking-widest"
                        style={`color: ${edu.accentColor};`}
                      >
                        {edu.category}
                      </span>
                      <span
                        class="mt-1 inline-block rounded-md px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider text-white"
                        style={`background-color: ${edu.accentColor};`}
                      >
                        {edu.badgeText}
                      </span>
                    </div>
                  </div>

                  <span class="edu-period-pill">
                    <i class="icofont icofont-calendar" style={`color: ${edu.accentColor};`} aria-hidden="true"></i>
                    <span>{edu.period}</span>
                  </span>
                </div>

                <h4 class="item-title !text-[1.1rem]">
                  {edu.institution}
                </h4>

                <p class="detail-copy mt-2">
                  {edu.detail}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t flex items-center justify-between text-xs font-medium" style="border-color: var(--card-border);">
                <span class="txt-primary inline-flex items-center gap-1.5">
                  <i class="icofont icofont-verification-check" style={`color: ${edu.accentColor};`} aria-hidden="true"></i>
                  <span>Credencial Verificada CV 2026</span>
                </span>
                <span class="font-semibold uppercase tracking-wider" style={`color: ${edu.accentColor};`}>
                  0{idx + 1}
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Redesigned Executive Continuous Training, Specializations & Competencies Showcase -->
      <details class="training-drawer mt-7 group" open>
        <summary class="training-summary">
          <div class="flex items-center gap-3.5">
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#0e3d65] text-gold border-2 border-[#cdb30c]"
              style="box-shadow: 0 3px 0 #08233a;"
              aria-hidden="true"
            >
              <i class="icofont icofont-certificate-alt-1 text-xl"></i>
            </span>
            <div>
              <span class="block text-base sm:text-lg font-medium uppercase tracking-wider" style="color: var(--heading-color);">
                Formación Continua, Cursos Especializados y Competencias (2023 - 2026)
              </span>
              <span class="block text-xs font-normal" style="color: var(--txt-muted);">
                10 especializaciones técnicas en Udemy & Platzi · 8 competencias ejecutivas de ingeniería
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="provider-badge" style="--provider-color: #A435F0;">
              <i class="icofont icofont-hat-alt" aria-hidden="true"></i>
              <span>Udemy (7)</span>
            </span>
            <span class="provider-badge" style="--provider-color: #079146;">
              <i class="icofont icofont-badge" aria-hidden="true"></i>
              <span>Platzi (3)</span>
            </span>
            <span
              class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#14171f] text-gold border-2 border-[#cdb30c] group-open:rotate-180 transition-transform"
              aria-hidden="true"
            >
              <i class="icofont icofont-rounded-down text-lg"></i>
            </span>
          </div>
        </summary>

        <div class="p-5 sm:p-6 border-t-2 grid grid-cols-1 lg:grid-cols-12 gap-7" style="border-color: var(--card-border); background-color: var(--th-secondary);">
          <!-- Left 8 Columns: 10 Specialized Courses with Solid Official Provider Badges -->
          <div class="lg:col-span-8">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
              <span class="label-c">Cursos y Especializaciones Recientes:</span>
              <span class="text-xs font-medium uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#0e3d65] text-white">
                Actualización 2023 – 2025
              </span>
            </div>

            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
              {
                coursesData.map((course) => (
                  <li
                    class="course-card"
                    style={`--provider-color: ${course.providerColor};`}
                  >
                    <div class="flex items-center justify-between gap-2">
                      <span class="provider-badge" style={`--provider-color: ${course.providerColor};`}>
                        <i class="icofont icofont-verification-check" aria-hidden="true"></i>
                        <span>{course.provider}</span>
                      </span>
                      <span
                        class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider"
                        style="background-color: var(--th-secondary); border: 1px solid var(--card-border); color: var(--txt-primary);"
                      >
                        <i class="icofont icofont-calendar" style={`color: ${course.providerColor};`} aria-hidden="true"></i>
                        <span>{course.date}</span>
                      </span>
                    </div>

                    <strong class="block font-medium text-[14.5px] leading-snug" style="color: var(--heading-color);">
                      {course.name}
                    </strong>

                    <div class="flex items-center justify-between pt-1 border-t" style="border-color: var(--card-border);">
                      <span class="text-[12px] font-normal" style="color: var(--txt-muted);">
                        Área: <strong class="font-medium txt-primary">{course.domain}</strong>
                      </span>
                      <i class="icofont icofont-check-circled text-sm" style={`color: ${course.providerColor};`} aria-hidden="true"></i>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Right 4 Columns: Executive Soft Skills & Leadership Competencies -->
          <div class="lg:col-span-4 flex flex-col justify-between gap-5">
            <div>
              <span class="label-c block mb-3.5">Competencias Profesionales:</span>
              <div class="grid grid-cols-1 gap-2.5">
                {
                  profileData.softSkills.map((skill, idx) => {
                    const badgeColor = idx % 2 === 0 ? '#0d9488' : '#2563eb';
                    return (
                      <div
                        class="flex items-center gap-3 rounded-xl p-2.5 border"
                        style={`background-color: var(--th-primary); border-color: var(--card-border); border-left: 4px solid ${badgeColor};`}
                      >
                        <span
                          class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-white text-xs"
                          style={`background-color: ${badgeColor};`}
                          aria-hidden="true"
                        >
                          <i class="icofont icofont-check-alt"></i>
                        </span>
                        <span class="text-[14px] font-normal txt-primary">
                          {skill}
                        </span>
                      </div>
                    );
                  })
                }
              </div>
            </div>

            <!-- Executive Summary Callout Card -->
            <div
              class="rounded-xl p-4 border-2 border-[#cdb30c] bg-[#14171f] text-white"
              style="box-shadow: 0 4px 0 #080a0f;"
            >
              <div class="flex items-center gap-2.5 mb-1.5">
                <i class="icofont icofont-award text-gold text-xl" aria-hidden="true"></i>
                <span class="text-xs font-semibold uppercase tracking-widest text-gold">
                  Enfoque de Ingeniería
                </span>
              </div>
              <p class="text-[13px] font-light text-[#e2e8f0] leading-relaxed">
                Arquitectura limpia (DDD & Hexagonal), seguridad desde el diseño (OWASP Top 10) y entrega continua en equipos ágiles distribuidos.
              </p>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>

  <!-- Top-Anchored Wave Divider (Hangs downward from #home into #about with 100% solid #14171f fill — ZERO straight line or gap!) -->
  <svg
    class="wave"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</section>
<!-- END ABOUT -->
