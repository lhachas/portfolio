---
import { profileData, socialLinks } from '../data/portfolio';

const currentYear = new Date().getFullYear();
---

<!-- START FOOTER -->
<footer class="footer-section">
  <div class="footer-content-wrapper mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-6">
      <div class="md:col-span-6 text-center md:text-left">
        <p class="body-copy text-[#d4d4d4] mb-0">
          {currentYear} © {profileData.brandPrefix}<span class="text-gold">{profileData.brandHighlight}</span>{profileData.brandSuffix}. Diseñado por{' '}
          <a
            class="text-gold hover:underline font-normal"
            href={profileData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            {profileData.name}
          </a>
        </p>
      </div>

      <!-- Official Brand-Colored Circular Social Buttons (100% Visible - Zero Wave Overlap) -->
      <div class="md:col-span-6">
        <ul class="flex flex-wrap items-center justify-center md:justify-end gap-3 mb-0" role="list">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target={social.id === 'email' ? undefined : '_blank'}
                  rel={social.id === 'email' ? undefined : 'noopener noreferrer'}
                  class={`social-icon-btn ${social.id}`}
                  aria-label={`${social.name} oficial de ${profileData.name} (${social.handle})`}
                  title={`${social.name}: ${social.handle}`}
                >
                  <i class={`icofont ${social.icon}`} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Top-Anchored SVG Wave Divider (Height Capped & z-index: 1 so it NEVER overlaps social buttons) -->
  <svg
    class="wave"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</footer>
<!-- END FOOTER -->
