---
import { profileData } from '../data/portfolio';
---

<!-- START HOME -->
<section class="section bg-home" id="home" aria-label="Presentación principal">
  <!-- Atmospheric Product-Designer Depth Layers (Over cartographer.png) -->
  <div class="hero-grid-overlay" aria-hidden="true"></div>
  <div class="hero-aurora-orb orb-gold" aria-hidden="true"></div>
  <div class="hero-aurora-orb orb-purple" aria-hidden="true"></div>

  <!-- Interactive Particle Constellation Canvas (Honors original tsparticles interactive network) -->
  <canvas
    id="hero-particles"
    class="pointer-events-none absolute inset-0 z-[2] h-full w-full opacity-65"
    aria-hidden="true"
  ></canvas>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 w-full pt-8 pb-6">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Live Recruiter Availability Status Pill -->
      <div class="mb-5 inline-flex justify-center">
        <a
          href="#contact"
          class="hero-status-pill"
          data-cursor-label="Disponible"
        >
          <span class="status-pulse-dot" aria-hidden="true"></span>
          <span>{profileData.availabilityBadge}</span>
          <i class="icofont icofont-verification-check text-gold text-sm" aria-hidden="true"></i>
        </a>
      </div>

      <!-- Greeting -->
      <p class="hero-greeting text-white/90 mb-2">
        {profileData.heroGreeting}
      </p>

      <!-- Typed Headline (Preserves Soy + Victor Mono Italic Gold Typed Text with descender clearance) -->
      <h1 class="home-title text-gold mb-0 flex flex-wrap items-center justify-center gap-x-3 pb-1">
        <span class="text-white font-light">Soy</span>
        <span class="inline-flex items-center pb-1">
          <em
            id="typed-output"
            class="typing italic font-semibold text-gold"
            data-strings={JSON.stringify(profileData.typedStrings)}
          >
            {profileData.typedStrings[0]}
          </em>
          <span class="typed-cursor" aria-hidden="true">|</span>
        </span>
      </h1>

      <!-- Value Proposition Subtitle (Unified .title-subtitle scale, strictly from 2026 CV) -->
      <p class="title-subtitle mt-4 mb-0 mx-auto text-gray-200/95">
        {profileData.heroSubtitle}
      </p>

      <!-- Core Architecture Stack Strip -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5" aria-label="Pilares tecnológicos principales">
        {
          profileData.heroArchitecturePills.map((arch) => (
            <span class="hero-arch-pill">
              <i class={arch.icon} aria-hidden="true"></i>
              <span>{arch.label}</span>
            </span>
          ))
        }
      </div>

      <!-- Primary & Secondary Pill CTAs (Preserves btn-gold + btn-theme-primary with slide-in arrow) -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="#about" class="btn-brand btn-gold" data-cursor-label="Explorar">
          <span>Lee Más</span>
        </a>
        <a href="#contact" class="btn-brand btn-theme-primary" data-cursor-label="Hablemos">
          <span>Contáctame</span>
        </a>
        <a
          href={profileData.cvBackendUrl}
          target="_blank"
          rel="noopener noreferrer"
          download="CV-Leonel-Hacha-Salazar-Backend-2026-ES.pdf"
          data-magnetic
          data-cursor-label="CV 2026"
          class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-[#cdb30c]/65 bg-[#cdb30c]/15 px-6 py-2.5 text-[13px] font-medium uppercase tracking-wider text-white backdrop-blur-xs transition-all hover:bg-[#cdb30c] hover:text-white"
        >
          <i class="icofont icofont-file-pdf text-gold text-base" aria-hidden="true"></i>
          <span>Descargar CV 2026</span>
        </a>
      </div>

      <!-- Official Social Network Brand Quick-Connect Bar -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3" aria-label="Perfiles profesionales verificados">
        <a
          href={profileData.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          data-cursor-label="LinkedIn"
          class="btn-social-pill linkedin"
          aria-label="Perfil oficial de LinkedIn de Leonel Hacha Salazar"
        >
          <i class="icofont icofont-linkedin" aria-hidden="true"></i>
          <span>LinkedIn</span>
        </a>
        <a
          href={profileData.github}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          data-cursor-label="GitHub"
          class="btn-social-pill github"
          aria-label="Perfil oficial de GitHub de Leonel Hacha Salazar"
        >
          <i class="icofont icofont-github" aria-hidden="true"></i>
          <span>GitHub</span>
        </a>
        <a
          href={profileData.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          data-cursor-label="WhatsApp"
          class="btn-social-pill whatsapp"
          aria-label="Contacto directo por WhatsApp de Leonel Hacha Salazar"
        >
          <i class="icofont icofont-whatsapp" aria-hidden="true"></i>
          <span>WhatsApp</span>
        </a>
      </div>

      <!-- Recruiter Impact Metrics Strip (With 3D perspective tilt & radial spotlight) -->
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center">
        {
          profileData.heroMetrics.map((metric, idx) => (
            <div
              class="hero-metric-card spotlight-card"
              data-tilt-card
              style={`--reveal-delay: ${idx * 80}ms;`}
            >
              <div class="mb-1.5 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[#cdb30c]/15 text-gold border border-[#cdb30c]/30">
                <i class={`icofont ${metric.icon} text-lg`} aria-hidden="true"></i>
              </div>
              <div class="text-xl sm:text-2xl font-medium text-gold tracking-wide">
                {metric.value}
              </div>
              <div class="mt-0.5 text-[14px] text-white font-normal tracking-wide">
                {metric.label}
              </div>
              <div class="mt-1 text-[12.5px] text-gray-300/85 font-light tracking-wide">
                {metric.detail}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Animated Scroll-Down Indicator -->
      <div class="mt-8 flex justify-center">
        <a
          href="#about"
          class="hero-scroll-indicator"
          aria-label="Desplazarse a la sección Sobre Mí"
        >
          <span class="scroll-mouse" aria-hidden="true">
            <span class="scroll-wheel"></span>
          </span>
          <span>Explorar Trayectoria</span>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- END HOME -->

<script>
  function initHeroEffects() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;
    const typedEl = document.getElementById('typed-output');
    const heroSection = document.getElementById('home');

    // 1. Lightweight Typewriter Effect (Replaces ngx-typed-js with zero heavy runtime)
    if (typedEl && !prefersReducedMotion) {
      const raw = typedEl.getAttribute('data-strings');
      const strings: string[] = raw ? JSON.parse(raw) : ['Leonel Hacha Salazar'];
      let strIndex = 0;
      let charIndex = strings[0].length;
      let isDeleting = true;

      const tick = () => {
        const currentFull = strings[strIndex];
        if (isDeleting) {
          charIndex--;
          typedEl.textContent = currentFull.substring(0, charIndex);
          if (charIndex === 0) {
            isDeleting = false;
            strIndex = (strIndex + 1) % strings.length;
            setTimeout(tick, 280);
            return;
          }
          setTimeout(tick, 40);
        } else {
          charIndex++;
          typedEl.textContent = currentFull.substring(0, charIndex);
          if (charIndex === currentFull.length) {
            isDeleting = true;
            setTimeout(tick, 2100);
            return;
          }
          setTimeout(tick, 82);
        }
      };

      setTimeout(tick, 1800);
    }

    // 2. Hero Interactive Cursor Spotlight & 3D Tilt Cards
    if (heroSection && isFinePointer && !prefersReducedMotion) {
      heroSection.addEventListener(
        'mousemove',
        (e) => {
          const rect = heroSection.getBoundingClientRect();
          const xPct = (((e.clientX - rect.left) / rect.width) * 100).toFixed(1);
          const yPct = (((e.clientY - rect.top) / rect.height) * 100).toFixed(1);
          heroSection.style.setProperty('--hero-mouse-x', `${xPct}%`);
          heroSection.style.setProperty('--hero-mouse-y', `${yPct}%`);
        },
        { passive: true }
      );

      const tiltCards = heroSection.querySelectorAll<HTMLElement>('[data-tilt-card]');
      tiltCards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const relX = (e.clientX - rect.left) / rect.width - 0.5;
          const relY = (e.clientY - rect.top) / rect.height - 0.5;
          const rotateX = (-relY * 7).toFixed(2);
          const rotateY = (relX * 7).toFixed(2);
          card.style.transform = `perspective(700px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });
    }

    // 3. Interactive Canvas Particle Constellation (Dual-toned Gold & Purple)
    const canvas = document.getElementById('hero-particles') as HTMLCanvasElement | null;
    if (!canvas || prefersReducedMotion) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = canvas.offsetWidth);
    let height = (canvas.height = canvas.offsetHeight);
    let pointerX = -9999;
    let pointerY = -9999;

    heroSection?.addEventListener(
      'mousemove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        pointerX = e.clientX - rect.left;
        pointerY = e.clientY - rect.top;
      },
      { passive: true }
    );

    heroSection?.addEventListener(
      'mouseleave',
      () => {
        pointerX = -9999;
        pointerY = -9999;
      },
      { passive: true }
    );

    const particleCount = Math.min(46, Math.floor((width * height) / 23000));
    const particles = Array.from({ length: particleCount }, (_, i) => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.45,
      vy: (Math.random() - 0.5) * 0.45,
      r: Math.random() * 1.8 + 1,
      isGold: i % 3 !== 0,
    }));

    const onResize = () => {
      if (!canvas) return;
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    };
    window.addEventListener('resize', onResize, { passive: true });

    const render = () => {
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.isGold ? 'rgba(205, 179, 12, 0.62)' : 'rgba(167, 139, 250, 0.55)';
        ctx.fill();

        // Connect nearby particles
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 138) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(205, 179, 12, ${0.16 * (1 - dist / 138)})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        // Interactive cursor connection
        const mdx = p.x - pointerX;
        const mdy = p.y - pointerY;
        const mDist = Math.sqrt(mdx * mdx + mdy * mdy);
        if (mDist < 175) {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(pointerX, pointerY);
          ctx.strokeStyle = `rgba(205, 179, 12, ${0.34 * (1 - mDist / 175)})`;
          ctx.lineWidth = 1.15;
          ctx.stroke();
        }
      }
      requestAnimationFrame(render);
    };
    render();
  }

  document.addEventListener('DOMContentLoaded', initHeroEffects);
</script>
