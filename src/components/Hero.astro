---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { hero, profile, socialLinks } = await getPortfolioContent(locale);
const heroSocials = socialLinks.filter((s) => s.showInHero);
---

<!-- START HOME -->
<section class="section bg-home" id="home" aria-label={hero.sectionAriaLabel}>
  <!-- Interactive Particle Constellation Canvas (100% Solid Geometric Network) -->
  <canvas
    id="hero-particles"
    class="pointer-events-none absolute inset-0 z-[2] h-full w-full"
    aria-hidden="true"
  ></canvas>

  <div id="hero-parallax-stage" class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 w-full pt-2 pb-2">
    <div class="mx-auto max-w-5xl text-center">
      <!-- Live Recruiter Availability Status Pill (100% Solid Minimalist Badge) -->
      <div class="mb-4 inline-flex justify-center" data-hero-anim>
        <a
          href={hero.secondaryCta.href}
          class="hero-status-pill"
          data-cursor-label={hero.availabilityCursorLabel}
        >
          <span class="status-pulse-dot" aria-hidden="true"></span>
          <span>{hero.availabilityBadge}</span>
          <i class="icofont icofont-verification-check text-gold text-sm" aria-hidden="true"></i>
        </a>
      </div>

      <!-- Greeting -->
      <p class="hero-greeting text-[#cbd5e1] mb-1.5" data-hero-anim>
        {hero.greeting}
      </p>

      <!-- Single-Line Typed Headline (Preserves Soy + Victor Mono Italic Dynamic Accent Typed Text without 2-line jump) -->
      <h1
        class="home-title text-gold mb-0 flex flex-wrap sm:flex-nowrap items-center justify-center gap-x-3 pb-1 min-h-[3.2rem] sm:min-h-[3.6rem]"
        data-hero-anim
      >
        <span class="text-white font-light shrink-0">{hero.titlePrefix}</span>
        <span class="inline-flex items-center pb-0.5 sm:whitespace-nowrap">
          <em
            id="typed-output"
            class="typing italic font-semibold text-gold"
            data-strings={JSON.stringify(hero.typedStrings)}
          >
            {hero.typedStrings[0]}
          </em>
          <span class="typed-cursor" aria-hidden="true">|</span>
        </span>
      </h1>

      <!-- Value Proposition Subtitle (Unified .title-subtitle scale, 100% solid crisp text) -->
      <p class="title-subtitle mt-3 mb-0 mx-auto text-[#e2e8f0]" data-hero-anim>
        {hero.subtitle}
      </p>

      <!-- Core Architecture Stack Strip (100% Solid Pills with Official Technology Brand Icon Badges) -->
      <div
        class="mt-5 flex flex-wrap items-center justify-center gap-2.5"
        aria-label={hero.architecturePillsAriaLabel}
        data-hero-anim
      >
        {
          hero.architecturePills.map((arch) => (
            <span class="hero-arch-pill" style={`--arch-brand: ${arch.brandColor};`}>
              <span class="hero-arch-icon-badge" aria-hidden="true">
                <i class={arch.icon}></i>
              </span>
              <span>{arch.label}</span>
            </span>
          ))
        }
      </div>

      <!-- Unified Product-Designer Action & Official Social Dock (100% Solid Colors - Zero Glassmorphism) -->
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3" data-hero-anim>
        <a
          href={hero.primaryCta.href}
          class="btn-brand btn-gold"
          data-cursor-label={hero.primaryCta.cursorLabel}
        >
          <span>{hero.primaryCta.label}</span>
        </a>
        <a
          href={hero.secondaryCta.href}
          class="btn-brand btn-theme-primary"
          data-cursor-label={hero.secondaryCta.cursorLabel}
        >
          <span>{hero.secondaryCta.label}</span>
        </a>
        <a
          href={withBase(profile.cvPrimary.url)}
          target="_blank"
          rel="noopener noreferrer"
          download={profile.cvPrimary.filename}
          data-magnetic
          data-cursor-label={hero.cvCtaCursorLabel}
          class="btn-outline-gold"
        >
          <i class="icofont icofont-file-pdf text-gold text-base" aria-hidden="true"></i>
          <span>{profile.cvPrimary.labelHero}</span>
        </a>
        <a
          href={withBase(profile.cvExtended.url)}
          target="_blank"
          rel="noopener noreferrer"
          download={profile.cvExtended.filename}
          data-magnetic
          data-cursor-label={hero.cvCtaCursorLabel}
          class="btn-outline-gold"
        >
          <i class="icofont icofont-file-pdf text-gold text-base" aria-hidden="true"></i>
          <span>{profile.cvExtended.labelHero}</span>
        </a>

        <span class="hidden lg:inline-block h-6 w-[2px] bg-[#2e3545] mx-1" aria-hidden="true"></span>

        {
          heroSocials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              data-cursor-label={social.name}
              class={`btn-social-pill ${social.id}`}
              aria-label={`${social.name} - ${profile.name}`}
              style={`background-color: ${social.brandColor}; border-color: ${social.brandColor};`}
            >
              <i class={`icofont ${social.icon}`} aria-hidden="true"></i>
              <span>{social.name}</span>
            </a>
          ))
        }
      </div>

      <!-- Recruiter Impact Metrics Strip (100% Solid Non-Monotonous Architectural Cards) -->
      <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center" data-hero-metrics>
        {
          hero.metrics.map((metric) => {
            const isBrandAccent = metric.accentColor.toLowerCase() === '#cdb30c';
            const resolvedAccent = isBrandAccent ? 'var(--brand-gold)' : metric.accentColor;
            const iconTextColor = isBrandAccent ? 'var(--brand-on-gold)' : '#ffffff';
            return (
              <div
                class="hero-metric-card"
                data-tilt-card
                data-hero-metric-item
                style={`--metric-accent: ${resolvedAccent};`}
              >
                <div
                  class="mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[#14171f]"
                  style={`background-color: ${resolvedAccent}; color: ${iconTextColor}; box-shadow: 0 3px 0 #0a0c10;`}
                >
                  <i class={`icofont ${metric.icon} text-lg`} aria-hidden="true"></i>
                </div>
                <div class="text-xl sm:text-2xl font-medium text-white tracking-wide">
                  {metric.value}
                </div>
                <div
                  class="mt-0.5 text-[13.5px] font-medium uppercase tracking-wider"
                  style={`color: ${resolvedAccent};`}
                >
                  {metric.label}
                </div>
                <div class="mt-1 text-[12.5px] text-[#cbd5e1] font-light tracking-wide">
                  {metric.detail}
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Animated Scroll-Down Indicator -->
      <div class="mt-6 flex justify-center" data-hero-anim>
        <a
          href={hero.scrollIndicator.href}
          class="hero-scroll-indicator"
          aria-label={hero.scrollIndicator.ariaLabel}
        >
          <span class="scroll-mouse" aria-hidden="true">
            <span class="scroll-wheel"></span>
          </span>
          <span>{hero.scrollIndicator.label}</span>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- END HOME -->

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHeroEffects() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;
    const typedEl = document.getElementById('typed-output');
    const heroSection = document.getElementById('home');
    const heroStage = document.getElementById('hero-parallax-stage');

    // 1. GSAP Orchestrated Entrance Timeline & Subtle Scroll Parallax
    if (!prefersReducedMotion && heroSection) {
      const heroAnimItems = heroSection.querySelectorAll('[data-hero-anim]');
      const metricItems = heroSection.querySelectorAll('[data-hero-metric-item]');

      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.fromTo(
        heroAnimItems,
        { y: 20, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 0.65, stagger: 0.08, clearProps: 'transform,opacity,visibility' }
      ).fromTo(
        metricItems,
        { y: 24, autoAlpha: 0, scale: 0.97 },
        { y: 0, autoAlpha: 1, scale: 1, duration: 0.55, stagger: 0.07, clearProps: 'transform,opacity,visibility' },
        '-=0.32'
      );

      if (heroStage) {
        gsap.to(heroStage, {
          yPercent: 10,
          ease: 'none',
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      }
    }

    // 2. Lightweight Single-Line Typewriter Effect
    if (typedEl && !prefersReducedMotion) {
      const raw = typedEl.getAttribute('data-strings');
      const strings: string[] = raw ? JSON.parse(raw) : [];
      if (strings.length > 0) {
        let strIndex = 0;
        let charIndex = strings[0].length;
        let isDeleting = true;

        const tick = () => {
          const currentFull = strings[strIndex];
          if (isDeleting) {
            charIndex--;
            typedEl.textContent = currentFull.substring(0, charIndex);
            if (charIndex === 0) {
              isDeleting = false;
              strIndex = (strIndex + 1) % strings.length;
              setTimeout(tick, 260);
              return;
            }
            setTimeout(tick, 38);
          } else {
            charIndex++;
            typedEl.textContent = currentFull.substring(0, charIndex);
            if (charIndex === currentFull.length) {
              isDeleting = true;
              setTimeout(tick, 2200);
              return;
            }
            setTimeout(tick, 76);
          }
        };

        setTimeout(tick, 1900);
      }
    }

    // 3. Solid 3D Perspective Tilt on Metric Cards
    if (heroSection && isFinePointer && !prefersReducedMotion) {
      const tiltCards = heroSection.querySelectorAll<HTMLElement>('[data-tilt-card]');
      tiltCards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const relX = (e.clientX - rect.left) / rect.width - 0.5;
          const relY = (e.clientY - rect.top) / rect.height - 0.5;
          const rotateX = (-relY * 5).toFixed(2);
          const rotateY = (relX * 5).toFixed(2);
          card.style.transform = `perspective(700px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });
    }

    // 4. Interactive Canvas Particle Constellation (100% Solid Hex Nodes & Lines, Responsive to Accent Changes)
    const canvas = document.getElementById('hero-particles') as HTMLCanvasElement | null;
    if (!canvas || prefersReducedMotion) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = canvas.offsetWidth);
    let height = (canvas.height = canvas.offsetHeight);
    let pointerX = -9999;
    let pointerY = -9999;

    const getActiveAccent = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--brand-gold').trim() || '#cdb30c';

    let activeAccent = getActiveAccent();

    heroSection?.addEventListener(
      'mousemove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        pointerX = e.clientX - rect.left;
        pointerY = e.clientY - rect.top;
      },
      { passive: true }
    );

    heroSection?.addEventListener(
      'mouseleave',
      () => {
        pointerX = -9999;
        pointerY = -9999;
      },
      { passive: true }
    );

    const particleCount = Math.min(36, Math.floor((width * height) / 28000));
    const secondaryPalette = ['#2563eb', '#0d9488', '#ea6a15'];
    const particles = Array.from({ length: particleCount }, (_, i) => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.38,
      vy: (Math.random() - 0.5) * 0.38,
      r: i % 3 === 0 ? 2.2 : 1.8,
      isAccent: i % 4 === 0,
      color: i % 4 === 0 ? activeAccent : secondaryPalette[i % secondaryPalette.length],
    }));

    window.addEventListener('portfolio:accent-change', ((e: CustomEvent<{ primary?: string }>) => {
      activeAccent = e.detail?.primary || getActiveAccent();
      particles.forEach((p) => {
        if (p.isAccent) p.color = activeAccent;
      });
    }) as EventListener);

    const onResize = () => {
      if (!canvas) return;
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    };
    window.addEventListener('resize', onResize, { passive: true });

    const render = () => {
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 125) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = dist < 70 ? '#333c4f' : '#1f2533';
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        const mdx = p.x - pointerX;
        const mdy = p.y - pointerY;
        const mDist = Math.sqrt(mdx * mdx + mdy * mdy);
        if (mDist < 160) {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(pointerX, pointerY);
          ctx.strokeStyle = mDist < 90 ? activeAccent : '#475569';
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.fill();
      }
      requestAnimationFrame(render);
    };
    render();
  }

  document.addEventListener('DOMContentLoaded', initHeroEffects);
</script>

