---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { about, profile, socialLinks } = await getPortfolioContent(locale);
const aboutSocials = socialLinks.filter((s) => s.showInAbout);
const { trainingShowcase } = about;
---

<!-- START ABOUT -->
<section class="section th-primary about" id="about" aria-labelledby="about-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title Header (Solid Architectural Medallion .title-icon) -->
    <div class="text-center reveal">
      <div class="title-icon inline-flex items-center justify-center">
        <Icon name="user" size={30} />
      </div>
      <h2 id="about-heading" class="title">
        {about.titlePrefix} <span class="font-medium">{about.titleHighlight}</span>
      </h2>
      <p class="txt-primary mt-3 title-subtitle mx-auto">
        {about.lead}
      </p>
    </div>

    <!-- Main 2-Column Content (Preserves circular profile photo + Full-Stack / Backend bio) -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Left Column: Circular Framed Profile Image -->
      <div class="lg:col-span-5 flex flex-col items-center reveal">
        <div class="iam-img-wrapper">
          <div class="iam-orbit-ring" aria-hidden="true"></div>
          <picture class="w-full h-full flex items-center justify-center">
            <source srcset={withBase('/assets/images/profile-portrait.webp')} type="image/webp" />
            <source srcset={withBase('/assets/images/profile-portrait.jpg')} type="image/jpeg" />
            <img
              class="iam-photo"
              src={withBase(profile.profilePhoto)}
              alt={profile.profilePhotoAlt}
              width="345"
              height="345"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <!-- Experience Solid Badge (Zero Blur Shadow) -->
          <div
            class="absolute -bottom-3 right-2 rounded-full bg-[#1e222d] border-2 border-gold px-4 py-1.5 text-white flex items-center gap-2"
            style="box-shadow: 0 4px 0 #0d0f14;"
          >
            <Icon name="code" size={15} class="text-gold shrink-0 inline-block" />
            <span class="text-xs font-medium uppercase tracking-wider">
              {profile.yearsExperience} {profile.yearsExperienceBadgeSuffix}
            </span>
          </div>
        </div>

        <!-- Languages & Location Quick Strip (100% Solid Non-Monotonous Pills) -->
        <div class="mt-7 flex flex-wrap items-center justify-center gap-2">
          <span class="tech-pill" style="--card-accent: var(--accent-1);">
            <Icon name="map-pin" size={14} class="text-gold shrink-0 inline-block" />
            <span>{profile.location}</span>
          </span>
          {
            profile.languages.map((lang, idx) => {
              const langSlots = ['var(--accent-2)', 'var(--accent-3)', 'var(--accent-4)'];
              const langAccent = langSlots[idx % langSlots.length];
              return (
                <span class="tech-pill" style={`--card-accent: ${langAccent};`}>
                  <strong>{lang.name}:</strong> <span>{lang.level}</span>
                </span>
              );
            })
          }
        </div>
      </div>

      <!-- Right Column: Senior Backend & Full-Stack Bio + Stack Pills + CTAs -->
      <div class="lg:col-span-7 reveal">
        <div class="features-desc">
          <h3 class="subsection-title">
            {about.roleTitle} <span class="font-medium">{about.roleHighlight}</span>
          </h3>

          {
            about.paragraphs.map((paragraph) => (
              <p class="body-copy txt-primary mt-4 text-justify sm:text-left">
                {paragraph}
              </p>
            ))
          }

          <!-- Core Stack Pills -->
          <div class="mt-5">
            <span class="label-c block mb-2.5">{about.coreStackLabel}</span>
            <div class="flex flex-wrap gap-2">
              {
                about.coreStackPills.map((tech, idx) => {
                  const accents = [
                    'var(--accent-1)',
                    'var(--accent-2)',
                    'var(--accent-3)',
                    'var(--accent-4)',
                    'var(--accent-5)',
                    'var(--accent-6)',
                  ];
                  const accent = accents[idx % accents.length];
                  return (
                    <span class="tech-pill" style={`--card-accent: ${accent};`}>
                      {tech}
                    </span>
                  );
                })
              }
            </div>
          </div>

          <!-- Action Buttons (Official CVs + Direct Contact + Official Social Brand Buttons) -->
          <div class="about-cta-row mt-7">
            <a
              href={withBase(profile.cvPrimary.url)}
              target="_blank"
              rel="noopener noreferrer"
              download={profile.cvPrimary.filename}
              data-magnetic
              data-cv-lang={profile.cvPrimary.langCode}
              class="btn-brand btn-gold"
              data-cursor-label={about.cvButtonCursorLabel}
              aria-label={profile.cvPrimary.ariaLabel}
            >
              <Icon name="file-pdf" size={16} class="mr-1.5 shrink-0 inline-block" />
              <span>{profile.cvPrimary.labelAbout}</span>
            </a>

            <a
              href={withBase(locale === 'en' ? '/en/contact' : '/contact')}
              data-nav-link="contact"
              class="btn-brand btn-theme-primary"
              data-cursor-label={about.contactButtonCursorLabel}
            >
              <span>{about.contactButtonLabel}</span>
            </a>

            {
              aboutSocials.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-magnetic
                  data-cursor-label={social.name}
                  class={`btn-social-pill ${social.id}`}
                >
                  <Icon name={social.id} size={16} />
                  <span>{social.name}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Redesigned Executive Education, Technical Training & Languages Cards (100% Solid Bento Architecture) -->
    <div class="mt-14 reveal">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          about.education.map((edu, idx) => {
            const eduSlots = ['var(--accent-1)', 'var(--accent-3)', 'var(--accent-4)'];
            const eduAccent = eduSlots[idx % eduSlots.length];
            return (
              <article
                class="edu-card"
                style={`--edu-accent: ${eduAccent}; --card-accent: ${eduAccent}; --reveal-delay: ${idx * 90}ms;`}
              >
                <div>
                  <!-- Header en filas limpias: medallión + período / eyebrow / badge (sin apiñamiento) -->
                  <div class="flex items-center justify-between gap-3 mb-3">
                    <span class="edu-icon-badge" aria-hidden="true">
                      <Icon name={edu.icon} size={22} />
                    </span>
                    <span class="edu-period-pill">
                      <Icon name="calendar" size={13} style={`color: ${eduAccent};`} class="inline-block shrink-0" />
                      <span>{edu.period}</span>
                    </span>
                  </div>

                  <span
                    class="block text-xs font-semibold uppercase tracking-widest"
                    style={`color: ${eduAccent};`}
                  >
                    {edu.category}
                  </span>
                  <span
                    class="mt-1.5 inline-block whitespace-nowrap rounded-md border px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider"
                    style={`border-width: 1.5px; border-color: ${eduAccent}; color: ${eduAccent}; background-color: var(--th-primary);`}
                  >
                    {edu.badgeText}
                  </span>

                  <h4 class="item-title !text-[1.1rem] mt-3">
                    {edu.institution}
                  </h4>

                  <p class="detail-copy mt-2">
                    {edu.detail}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t flex items-center justify-between text-xs font-medium" style="border-color: var(--card-border);">
                  <span class="txt-primary inline-flex items-center gap-1.5">
                    <Icon name="check" size={13} style={`color: ${eduAccent};`} class="inline-block shrink-0" />
                    <span>{about.educationVerifiedLabel}</span>
                  </span>
                  <span class="font-semibold uppercase tracking-wider" style={`color: ${eduAccent};`}>
                    0{idx + 1}
                  </span>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- Redesigned Executive Professional Development, Specializations & Competencies Showcase -->
      <details class="training-drawer mt-7 group" open>
        <summary class="training-summary">
          <div class="flex items-center gap-3.5">
            <span class="training-icon-badge" aria-hidden="true">
              <Icon name="award" size={22} class="text-gold" />
            </span>
            <div>
              <span class="block text-base sm:text-lg font-medium uppercase tracking-wider" style="color: var(--heading-color);">
                {trainingShowcase.title}
              </span>
              <span class="block text-xs font-normal" style="color: var(--txt-muted);">
                {trainingShowcase.subtitle}
              </span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            {
              trainingShowcase.providerSummaryBadges.map((badge, idx) => {
                const summarySlots = ['var(--accent-1)', 'var(--accent-4)'];
                const badgeAccent = summarySlots[idx % summarySlots.length];
                return (
                  <span class="provider-badge" style={`--provider-color: ${badgeAccent};`}>
                    <Icon name={badge.icon} size={14} class="shrink-0" />
                    <span>{badge.label}</span>
                  </span>
                );
              })
            }
            <span class="training-toggle-btn" aria-hidden="true">
              <Icon name="chevron-down" size={16} class="text-gold group-open:rotate-180 transition-transform duration-300" />
            </span>
          </div>
        </summary>

        <div class="p-5 sm:p-6 border-t-2 grid grid-cols-1 lg:grid-cols-12 gap-7" style="border-color: var(--card-border); background-color: var(--th-secondary);">
          <!-- Left 8 Columns: Professional Development Pillars from Official 2026 CVs -->
          <div class="lg:col-span-8">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
              <span class="label-c">{trainingShowcase.coursesHeading}</span>
              <span class="training-period-pill">
                <Icon name="calendar" size={12} class="text-gold shrink-0" />
                <span>{trainingShowcase.coursesPeriodBadge}</span>
              </span>
            </div>

            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" role="list">
              {
                trainingShowcase.courses.map((course, idx) => {
                  const courseSlots = [
                    'var(--accent-1)',
                    'var(--accent-3)',
                    'var(--accent-4)',
                    'var(--accent-2)',
                    'var(--accent-6)',
                    'var(--accent-5)',
                    'var(--accent-2)',
                    'var(--accent-4)',
                  ];
                  const courseAccent = courseSlots[idx % courseSlots.length];
                  return (
                    <li
                      class="course-card"
                      style={`--provider-color: ${courseAccent}; --card-accent: ${courseAccent};`}
                    >
                      <div class="flex items-center justify-between gap-2">
                        <span class="provider-badge" style={`--provider-color: ${courseAccent};`}>
                          <Icon name="check" size={12} class="inline-block shrink-0" />
                          <span>{course.provider}</span>
                        </span>
                        <span class="course-date-pill">
                          <Icon name="calendar" size={12} style={`color: ${courseAccent};`} class="inline-block shrink-0" />
                          <span>{course.date}</span>
                        </span>
                      </div>

                      <strong class="course-title">
                        {course.name}
                      </strong>

                      <div class="course-footer">
                        <span class="text-[12px] font-normal" style="color: var(--txt-muted);">
                          {trainingShowcase.courseDomainPrefix} <strong class="font-medium txt-primary">{course.domain}</strong>
                        </span>
                        <Icon name="check" size={13} style={`color: ${courseAccent};`} class="inline-block shrink-0" />
                      </div>
                    </li>
                  );
                })
              }
            </ul>
          </div>

          <!-- Right 4 Columns: Executive Soft Skills & Leadership Competencies -->
          <div class="lg:col-span-4 flex flex-col justify-between gap-5">
            <div>
              <span class="label-c block mb-3.5">{trainingShowcase.competenciesHeading}</span>
              <div class="grid grid-cols-1 gap-2.5">
                {
                  trainingShowcase.softSkills.map((skill, idx) => {
                    // Colores variados originales: rotación de los 6 slots (lenguaje v2 aceptado)
                    const softSkillSlots = [
                      'var(--accent-1)',
                      'var(--accent-2)',
                      'var(--accent-3)',
                      'var(--accent-4)',
                      'var(--accent-5)',
                      'var(--accent-6)',
                    ];
                    const badgeColor = softSkillSlots[idx % softSkillSlots.length];
                    return (
                      <div
                        class="competency-card"
                        style={`--competency-color: ${badgeColor};`}
                      >
                        <span
                          class="competency-badge"
                          style={`background-color: ${badgeColor};`}
                          aria-hidden="true"
                        >
                          <Icon name="check" size={12} class="text-white" />
                        </span>
                        <span class="competency-label">
                          {skill}
                        </span>
                      </div>
                    );
                  })
                }
              </div>
            </div>

            <!-- Executive Summary Callout Card (100% Solid Architectural Surface) -->
            <div class="training-callout-card">
              <div class="flex items-center gap-2.5 mb-2">
                <Icon name="award" size={20} class="text-gold shrink-0" />
                <span class="training-callout-title">
                  {trainingShowcase.engineeringFocusCallout.title}
                </span>
              </div>
              <p class="training-callout-desc">
                {trainingShowcase.engineeringFocusCallout.description}
              </p>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>

  <!-- Top-Anchored Wave Divider (Hangs downward from #home into #about with 100% solid #14171f fill — ZERO straight line or gap!) -->
  <svg
    class="wave"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</section>
<!-- END ABOUT -->

