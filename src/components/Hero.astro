---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import BrandRubric from './BrandRubric.astro';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { hero, profile } = await getPortfolioContent(locale);
---

<!-- START HOME -->
<section class="section bg-home relative overflow-hidden" id="home" aria-label={hero.sectionAriaLabel}>
  <!-- Hero Circuit Backdrop — topología de servicios determinista (canvas único, sin assets externos) -->
  <canvas
    id="hero-circuit-canvas"
    class="hero-circuit-canvas"
    aria-hidden="true"
  ></canvas>
  <div class="hero-canvas-overlay" aria-hidden="true"></div>
  <div id="hero-parallax-stage" class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 w-full pt-2 pb-2">
    <!-- Marco blueprint: esquinas de registro + micro-etiqueta HUD (datos desde el SSOT) -->
    <span class="hero-corner tl" aria-hidden="true"></span>
    <span class="hero-corner tr" aria-hidden="true"></span>
    <span class="hero-corner bl" aria-hidden="true"></span>
    <span class="hero-corner br" aria-hidden="true"></span>
    <span class="hero-hud-label" aria-hidden="true">
      {profile.brandPrefix}{profile.brandHighlight}{profile.brandSuffix} // {profile.locationShort}
    </span>
    <div id="hero-tilt-stage" class="mx-auto max-w-5xl text-center">
      <!-- Live Recruiter Availability Status Pill (100% Solid Utilitarian Badge) -->
      <div class="mb-4 inline-flex items-center justify-center" data-hero-anim>
        <a
          href={withBase(locale === 'en' ? '/en/contact' : '/contact')}
          data-nav-link="contact"
          class="hero-status-pill"
          data-cursor-label={hero.availabilityCursorLabel}
        >
          <span class="status-pulse-dot" aria-hidden="true"></span>
          <span>{hero.availabilityBadge}</span>
          <Icon name="check" size={14} class="text-gold shrink-0 inline-block" />
        </a>
      </div>

      <!-- Greeting -->
      <p class="hero-greeting mb-1.5" data-hero-anim>
        {hero.greeting}
      </p>

      <!-- Single-Line Typed Headline (Preserves Soy + Victor Mono Italic Dynamic Accent Typed Text without 2-line jump) -->
      <h1
        class="home-title text-gold mb-0 flex flex-wrap sm:flex-nowrap items-center justify-center gap-x-3 pb-1 min-h-[3.2rem] sm:min-h-[3.6rem]"
        data-hero-anim
      >
        <span class="hero-title-prefix font-light shrink-0">{hero.titlePrefix}</span>
        <span class="relative inline sm:inline-flex items-center pb-0.5 sm:whitespace-nowrap">
          <em
            id="typed-output"
            class="typing italic font-semibold text-gold"
            data-strings={JSON.stringify(hero.typedStrings)}
          >
            {hero.typedStrings[0]}
          </em>
          <span class="typed-cursor" aria-hidden="true"></span>
          <!-- La rúbrica subraya exactamente el ancho del texto tecleado (keystroke a keystroke) -->
          <span
            id="hero-rubric-underline"
            class="hero-rubric-underline"
            data-hero-anim
            aria-hidden="true"
          >
            <BrandRubric stretch class="hero-rubric-svg" />
          </span>
        </span>
      </h1>

      <!-- Value Proposition Subtitle (Unified .title-subtitle scale, 100% solid crisp text) -->
      <p class="title-subtitle hero-subtitle mt-3 mb-0 mx-auto" data-hero-anim>
        {hero.subtitle}
      </p>

      <!-- Core Architecture Stack Strip (100% Solid Pills with Official SVGL Brand Icon Badges) -->
      <div
        class="hero-arch-strip mt-5 flex flex-wrap items-center justify-center gap-2.5"
        aria-label={hero.architecturePillsAriaLabel}
        data-hero-anim
      >
        {
          hero.architecturePills.map((arch) => (
            <span class="hero-arch-pill" style={`--arch-brand: ${arch.brandColor};`}>
              <span class="hero-arch-icon-badge" aria-hidden="true">
                <Icon name={arch.icon} size={17} />
              </span>
              <span>{arch.label}</span>
            </span>
          ))
        }
      </div>

      <!-- Hero Action CTAs (1 Primary + 1 Secondary, 100% Solid Surfaces, WCAG AAA Contrast, Tactile Micro-Interactions) -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3.5" data-hero-anim>
        <a
          href={withBase(locale === 'en' ? '/en/projects' : '/projects')}
          data-nav-link="projects"
          class="hero-btn-primary"
          data-cursor-label={hero.primaryCta.cursorLabel}
        >
          <Icon name="terminal" size={17} class="shrink-0" />
          <span>{hero.primaryCta.label}</span>
          <Icon name="chevron-right" size={14} class="shrink-0" />
        </a>

        <a
          href={withBase(locale === 'en' ? '/en/contact' : '/contact')}
          data-nav-link="contact"
          class="hero-btn-secondary"
          data-cursor-label={hero.secondaryCta.cursorLabel}
        >
          <Icon name="message" size={16} class="shrink-0 text-gold" />
          <span>{hero.secondaryCta.label}</span>
        </a>
      </div>

      <!-- Recruiter Impact Metrics Strip (100% Solid Non-Monotonous Architectural Cards) -->
      <div class="mt-7 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center" data-hero-metrics>
        {
          hero.metrics.map((metric, idx) => {
            const metricSlots = [
              'var(--accent-1)',
              'var(--accent-2)',
              'var(--accent-3)',
              'var(--accent-4)',
            ];
            const resolvedAccent = metricSlots[idx % metricSlots.length];
            const iconTextColor = '#ffffff';
            return (
              <div
                class="hero-metric-card"
                data-tilt-card
                data-hero-metric-item
                style={`--metric-accent: ${resolvedAccent}; --card-accent: ${resolvedAccent};`}
              >
                <div
                  class="hero-metric-badge mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl border-2"
                  style={`background-color: ${resolvedAccent}; color: ${iconTextColor};`}
                >
                  <Icon name={metric.icon} size={19} class="shrink-0" />
                </div>
                <div class="hero-metric-val text-xl sm:text-2xl font-medium tracking-wide">
                  {metric.value}
                </div>
                <div
                  class="hero-metric-label mt-0.5 text-[13.5px] font-medium uppercase tracking-wider"
                  style={`color: ${resolvedAccent};`}
                >
                  {metric.label}
                </div>
                <div class="hero-metric-desc mt-1 text-[12.5px] font-light tracking-wide">
                  {metric.detail}
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Animated Scroll-Down Indicator -->
      <div class="mt-8 sm:mt-10 mb-1 flex justify-center" data-hero-anim>
        <a
          href={withBase(locale === 'en' ? '/en/about' : '/about')}
          data-nav-link="about"
          class="hero-scroll-indicator"
          aria-label={hero.scrollIndicator.ariaLabel}
        >
          <span class="scroll-mouse" aria-hidden="true">
            <span class="scroll-wheel"></span>
          </span>
          <span>{hero.scrollIndicator.label}</span>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- END HOME -->

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHeroEffects() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;
    const typedEl = document.getElementById('typed-output');
    const heroSection = document.getElementById('home');
    const heroStage = document.getElementById('hero-parallax-stage');
    const heroTiltStage = document.getElementById('hero-tilt-stage');

    // 1. GSAP Orchestrated Entrance Timeline & Subtle Scroll Parallax
    if (!prefersReducedMotion && heroSection) {
      const heroAnimItems = heroSection.querySelectorAll('[data-hero-anim]');
      const metricItems = heroSection.querySelectorAll('[data-hero-metric-item]');

      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.fromTo(
        heroAnimItems,
        { y: 20, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 0.65, stagger: 0.08, clearProps: 'transform,opacity,visibility' }
      ).fromTo(
        metricItems,
        { y: 24, autoAlpha: 0, scale: 0.97 },
        { y: 0, autoAlpha: 1, scale: 1, duration: 0.55, stagger: 0.07, clearProps: 'transform,opacity,visibility' },
        '-=0.32'
      );

      // Masked headline reveal (H1) — orquestado al inicio de la timeline
      const headline = heroSection.querySelector<HTMLElement>('.home-title');
      if (headline) {
        tl.fromTo(
          headline,
          { clipPath: 'inset(0 0 100% 0)' },
          { clipPath: 'inset(0 0 0% 0)', duration: 0.75, ease: 'power3.out', clearProps: 'clip-path' },
          0.1
        );
      }

      // Huella de marca: la rúbrica se dibuja a mano tras asentarse el H1
      const rubricPath = heroSection.querySelector('#hero-rubric-underline path');
      if (rubricPath) {
        tl.fromTo(
          rubricPath,
          { strokeDashoffset: 1 },
          { strokeDashoffset: 0, duration: 0.9, ease: 'power2.out' },
          0.95
        );
      }

      if (heroStage) {
        gsap.to(heroStage, {
          yPercent: 10,
          ease: 'none',
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      }
    }

    // 2. Lightweight Single-Line Typewriter Effect
    if (typedEl && !prefersReducedMotion) {
      const raw = typedEl.getAttribute('data-strings');
      const strings: string[] = raw ? JSON.parse(raw) : [];
      if (strings.length > 0) {
        let strIndex = 0;
        let charIndex = strings[0].length;
        let isDeleting = true;

        const tick = () => {
          const currentFull = strings[strIndex];
          if (isDeleting) {
            charIndex--;
            typedEl.textContent = currentFull.substring(0, charIndex);
            if (charIndex === 0) {
              isDeleting = false;
              strIndex = (strIndex + 1) % strings.length;
              setTimeout(tick, 260);
              return;
            }
            setTimeout(tick, 38);
          } else {
            charIndex++;
            typedEl.textContent = currentFull.substring(0, charIndex);
            if (charIndex === currentFull.length) {
              isDeleting = true;
              setTimeout(tick, 2200);
              return;
            }
            setTimeout(tick, 76);
          }
        };

        setTimeout(tick, 1900);
      }
    }

    // 3. Solid 3D Perspective Tilt on Metric Cards
    if (heroSection && isFinePointer && !prefersReducedMotion) {
      const tiltCards = heroSection.querySelectorAll<HTMLElement>('[data-tilt-card]');
      tiltCards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const relX = (e.clientX - rect.left) / rect.width - 0.5;
          const relY = (e.clientY - rect.top) / rect.height - 0.5;
          const rotateX = (-relY * 5).toFixed(2);
          const rotateY = (relX * 5).toFixed(2);
          card.style.transform = `perspective(700px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });
    }

    // 3b. 3D Interactive Mouse Parallax across Hero Stage & Architecture Stack Pills
    if (heroSection && isFinePointer && !prefersReducedMotion && heroTiltStage) {
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        const relX = (e.clientX - rect.left) / rect.width - 0.5;
        const relY = (e.clientY - rect.top) / rect.height - 0.5;

        // Stage perspective micro-tilt and smooth translation (isolated from ScrollTrigger container)
        gsap.to(heroTiltStage, {
          rotationY: relX * 5,
          rotationX: -relY * 5,
          x: relX * 14,
          y: relY * 10,
          duration: 0.45,
          ease: 'power2.out',
          transformPerspective: 1200,
        });
      });

      heroSection.addEventListener('mouseleave', () => {
        gsap.to(heroTiltStage, {
          rotationY: 0,
          rotationX: 0,
          x: 0,
          y: 0,
          duration: 0.75,
          ease: 'power2.out',
        });
      });
    }

    // 3c. Micro-Interactions on Badges
    if (isFinePointer && !prefersReducedMotion) {
      const magneticTargets = document.querySelectorAll<HTMLElement>(
        '.hero-status-pill, .hero-btn-primary, .hero-btn-secondary'
      );
      magneticTargets.forEach((target) => {
        target.addEventListener('mousemove', (e) => {
          const rect = target.getBoundingClientRect();
          const relX = e.clientX - (rect.left + rect.width / 2);
          const relY = e.clientY - (rect.top + rect.height / 2);
          gsap.to(target, {
            x: relX * 0.24,
            y: relY * 0.24,
            duration: 0.25,
            ease: 'power2.out',
          });
        });
        target.addEventListener('mouseleave', () => {
          gsap.to(target, {
            x: 0,
            y: 0,
            duration: 0.55,
            ease: 'elastic.out(1, 0.4)',
          });
        });
      });
    }

    // 4. Hero Circuit Backdrop — topología de servicios determinista (una sola voz visual)
    const canvas = document.getElementById('hero-circuit-canvas') as HTMLCanvasElement | null;
    if (!canvas || !heroSection) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const mulberry32 = (seed: number) => () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    interface SceneNode { x: number; y: number; primary: boolean; }
    interface Trace { ax: number; ay: number; bx: number; by: number; hFirst: boolean; active: boolean; accent: number; phase: number; }
    interface Scene { nodes: SceneNode[]; traces: Trace[]; }
    let scene: Scene = { nodes: [], traces: [] };
    let width = 0;
    let height = 0;
    let accentColors: string[] = ['#3f87f5', '#0d9488', '#7c3aed'];
    let nodeFill = '#1e222d';
    let backdropVisible = true;

    const readAccents = () => {
      const s = getComputedStyle(document.documentElement);
      accentColors = [1, 2, 3].map((i) => s.getPropertyValue('--accent-' + i).trim() || accentColors[i - 1] || '#3f87f5');
    };
    const readSurface = () => {
      nodeFill = getComputedStyle(document.documentElement).getPropertyValue('--th-primary').trim() || '#1e222d';
    };
    readAccents();
    readSurface();
    window.addEventListener('portfolio:accent-change', () => {
      readAccents();
      readSurface();
      if (prefersReducedMotion) drawScene(0);
    });

    const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

    const buildScene = () => {
      const rand = mulberry32(20260715);
      const mx = Math.max(96, width * 0.14);
      const top = height * 0.18;
      const bottom = height * 0.82;
      const bandH = Math.max(bottom - top, 120);
      const cols = Math.min(8, Math.max(4, Math.floor((width - 2 * mx) / 150)));
      const rows = Math.min(6, Math.max(3, Math.floor(bandH / 125)));
      const nodes: SceneNode[] = [];
      const cellW = (width - 2 * mx) / Math.max(cols - 1, 1);
      const cellH = bandH / Math.max(rows - 1, 1);
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const jx = (rand() - 0.5) * cellW * 0.36;
          const jy = (rand() - 0.5) * cellH * 0.36;
          nodes.push({ x: mx + c * cellW + jx, y: top + r * cellH + jy, primary: rand() < 0.18 });
        }
      }
      const traces: Trace[] = [];
      const at = (r: number, c: number) => nodes[r * cols + c];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const n = at(r, c);
          if (c < cols - 1 && rand() < 0.6) {
            const m = at(r, c + 1);
            traces.push({ ax: n.x, ay: n.y, bx: m.x, by: m.y, hFirst: true, active: rand() < 0.45, accent: Math.floor(rand() * 3), phase: rand() });
          }
          if (r < rows - 1 && rand() < 0.45) {
            const m = at(r + 1, c);
            traces.push({ ax: n.x, ay: n.y, bx: m.x, by: m.y, hFirst: false, active: rand() < 0.4, accent: Math.floor(rand() * 3), phase: rand() });
          }
        }
      }
      scene = { nodes, traces };
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildScene();
      if (prefersReducedMotion) drawScene(0);
    };

    const roundedSquare = (x: number, y: number, s: number) => {
      const r = 3;
      ctx.beginPath();
      ctx.moveTo(x - s / 2 + r, y - s / 2);
      ctx.arcTo(x + s / 2, y - s / 2, x + s / 2, y + s / 2, r);
      ctx.arcTo(x + s / 2, y + s / 2, x - s / 2, y + s / 2, r);
      ctx.arcTo(x - s / 2, y + s / 2, x - s / 2, y - s / 2, r);
      ctx.arcTo(x - s / 2, y - s / 2, x + s / 2, y - s / 2, r);
      ctx.closePath();
    };

    const drawScene = (time: number) => {
      const dark = isDark();
      const ink = dark ? '167,181,201' : '51,65,85';
      ctx.clearRect(0, 0, width, height);

      // Retícula blueprint (menor + mayor)
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(' + ink + ', ' + (dark ? 0.055 : 0.05) + ')';
      ctx.beginPath();
      for (let x = 32; x < width; x += 32) { ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, height); }
      for (let y = 32; y < height; y += 32) { ctx.moveTo(0, y + 0.5); ctx.lineTo(width, y + 0.5); }
      ctx.stroke();
      ctx.strokeStyle = 'rgba(' + ink + ', ' + (dark ? 0.09 : 0.08) + ')';
      ctx.beginPath();
      for (let x = 160; x < width; x += 160) { ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, height); }
      for (let y = 160; y < height; y += 160) { ctx.moveTo(0, y + 0.5); ctx.lineTo(width, y + 0.5); }
      ctx.stroke();

      // Trazas de circuito ortogonales
      for (const tr of scene.traces) {
        const midX = tr.hFirst ? tr.bx : tr.ax;
        const midY = tr.hFirst ? tr.ay : tr.by;
        ctx.beginPath();
        ctx.moveTo(tr.ax, tr.ay);
        ctx.lineTo(midX, midY);
        ctx.lineTo(tr.bx, tr.by);
        if (tr.active) {
          ctx.strokeStyle = accentColors[tr.accent % accentColors.length];
          ctx.globalAlpha = 0.35;
          ctx.lineWidth = 1.5;
        } else {
          ctx.strokeStyle = 'rgba(' + ink + ', ' + (dark ? 0.22 : 0.18) + ')';
          ctx.globalAlpha = 1;
          ctx.lineWidth = 1.2;
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
      }

      // Pulsos viajando por las trazas activas
      if (!prefersReducedMotion) {
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        for (const tr of scene.traces) {
          if (!tr.active) continue;
          const len = tr.hFirst ? Math.abs(tr.bx - tr.ax) : Math.abs(tr.by - tr.ay);
          const cycle = len * 2 + 121;
          const u = ((time * 0.028 + tr.phase * cycle) % cycle) - 60;
          const head = Math.max(0, Math.min(len, u));
          const tail = Math.max(0, Math.min(len, u - 30));
          if (head <= tail) continue;
          const ux = tr.hFirst ? tr.ax + tail : tr.ax;
          const uy = tr.hFirst ? tr.ay : tr.ay + tail;
          const vx = tr.hFirst ? tr.ax + head : tr.ax;
          const vy = tr.hFirst ? tr.ay : tr.ay + head;
          const jx = tr.hFirst ? vx : ux;
          const jy = tr.hFirst ? uy : vy;
          ctx.strokeStyle = accentColors[tr.accent % accentColors.length];
          ctx.globalAlpha = 0.85;
          ctx.beginPath();
          ctx.moveTo(ux, uy);
          ctx.lineTo(jx, jy);
          ctx.lineTo(vx, vy);
          ctx.stroke();
          ctx.globalAlpha = 1;
        }
      }

      // Nodos: chips cuadrados redondeados (mismo lenguaje que .title-icon)
      for (const nd of scene.nodes) {
        if (nd.primary) {
          ctx.fillStyle = accentColors[0];
          roundedSquare(nd.x, nd.y, 13);
          ctx.fill();
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, 2.2, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillStyle = nodeFill;
          roundedSquare(nd.x, nd.y, 10);
          ctx.fill();
          ctx.lineWidth = 1.6;
          ctx.strokeStyle = dark ? 'rgba(167,181,201,0.55)' : 'rgba(51,65,85,0.5)';
          ctx.stroke();
        }
      }
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (prefersReducedMotion) {
      drawScene(0);
    } else {
      if ('IntersectionObserver' in window && heroSection) {
        new IntersectionObserver((entries) => { backdropVisible = entries[0].isIntersecting; }, { threshold: 0.02 }).observe(heroSection);
      }
      const loop = (t: number) => {
        if (backdropVisible && !document.hidden) drawScene(t);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }

  document.addEventListener('DOMContentLoaded', initHeroEffects);
</script>

