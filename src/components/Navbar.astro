---
import { navItems, profileData, withBase } from '../data/portfolio';
---

<!-- START NAVBAR -->
<header>
  <nav
    class="navbar-custom fixed top-0 left-0 right-0"
    id="navbar"
    aria-label="Navegación principal"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex min-h-[72px] items-center justify-between">
        <!-- Brand Logo (Preserves boy.png + LHachaS with gold Hacha) -->
        <a class="navbar-brand-logo" href="#home" aria-label="Ir al inicio - LHachaS">
          <img
            class="navbar-brand-img"
            src={withBase('/assets/images/icons/boy.png')}
            alt="Avatar de desarrollador Leonel Hacha Salazar"
            width="46"
            height="46"
          />
          <div>
            {profileData.brandPrefix}<span class="text-gold">{profileData.brandHighlight}</span>{profileData.brandSuffix}
          </div>
        </a>

        <!-- Desktop Navigation Links (Preserves icon above uppercase text + #cdb30c active block) -->
        <ul class="hidden lg:flex items-stretch mx-auto" id="navbar-navlist">
          {
            navItems.map((item, index) => (
              <li class="flex">
                <a
                  href={`#${item.id}`}
                  data-nav-link={item.id}
                  class:list={['nav-item-link', { active: index === 0 }]}
                >
                  <i class={`nav-icon icofont ${item.icon}`} aria-hidden="true" />
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Right Controls: Phone + Theme Switcher + Mobile Hamburger -->
        <div class="flex items-center gap-4">
          <a
            href={`tel:${profileData.phoneClean}`}
            class="hidden sm:inline-flex items-center gap-1.5 text-white hover:text-[#cdb30c] transition-colors text-sm font-semibold tracking-wide"
            aria-label={`Llamar al ${profileData.phone}`}
          >
            <i class="icofont icofont-ui-cell-phone text-gold text-lg" aria-hidden="true"></i>
            <span class="text-sm font-normal tracking-wider">{profileData.phone}</span>
          </a>

          <!-- Light / Dark Mode Switcher (Preserves icofont-night / icofont-sun-alt) -->
          <button
            type="button"
            id="theme-toggle-btn"
            data-magnetic
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-[#cdb30c] hover:text-white transition-colors cursor-pointer"
            aria-label="Cambiar entre modo claro y oscuro"
            title="Cambiar tema claro/oscuro"
          >
            <i id="theme-toggle-icon" class="icofont icofont-night text-lg" aria-hidden="true"></i>
          </button>

          <!-- Mobile Menu Button -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-lg border border-white/15 text-white hover:bg-[#cdb30c] transition-colors cursor-pointer"
            aria-controls="navbarCollapse"
            aria-expanded="false"
            aria-label="Abrir menú de navegación"
          >
            <i id="mobile-menu-icon" class="icofont icofont-navigation-menu text-xl" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Collapsible Navigation -->
      <div
        id="navbarCollapse"
        class="hidden lg:hidden border-t border-white/10 pb-4 pt-2"
      >
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            navItems.map((item, index) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-nav-link={item.id}
                  class:list={['nav-item-link rounded-lg py-3', { active: index === 0 }]}
                >
                  <i class={`nav-icon icofont ${item.icon}`} aria-hidden="true" />
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 pt-3 border-t border-white/10 flex items-center justify-center sm:hidden">
          <a
            href={`tel:${profileData.phoneClean}`}
            class="inline-flex items-center gap-2 text-white text-sm font-semibold"
          >
            <i class="icofont icofont-ui-cell-phone text-gold text-lg" aria-hidden="true"></i>
            <span>{profileData.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
<!-- END NAVBAR -->

<script>
  function setupNavbar() {
    const navbar = document.getElementById('navbar');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('navbarCollapse');
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-toggle-icon');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

    // Sync theme icon with current data-theme
    function syncThemeIcon() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      if (themeIcon) {
        themeIcon.className = current === 'dark' ? 'icofont icofont-sun-alt text-lg text-[#cdb30c]' : 'icofont icofont-night text-lg';
      }
    }
    syncThemeIcon();

    // Toggle Light/Dark Theme
    themeBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('user-theme', next);
      } catch (e) {}
      syncThemeIcon();
    });

    // Mobile Menu Toggle
    mobileBtn?.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu?.classList.toggle('hidden');
    });

    // Close mobile menu when clicking a link
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024 && mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Sticky Navbar state using IntersectionObserver on a top sentinel or passive scroll
    const updateSticky = () => {
      if (!navbar) return;
      if (window.scrollY > 40) {
        navbar.classList.add('nav-sticky');
      } else {
        navbar.classList.remove('nav-sticky');
      }
    };
    updateSticky();
    window.addEventListener('scroll', updateSticky, { passive: true });

    // Deterministic Scrollspy based on viewport scroll position
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    const updateScrollSpy = () => {
      const scrollPos = window.scrollY + 240;
      let currentId = 'home';
      if (window.scrollY >= 120) {
        for (const section of sections) {
          if (section.offsetTop <= scrollPos) {
            currentId = section.id;
          }
        }
      }
      navLinks.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-link') === currentId;
        link.classList.toggle('active', isMatch);
      });
    };
    updateScrollSpy();
    window.addEventListener('scroll', updateScrollSpy, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', setupNavbar);
</script>
