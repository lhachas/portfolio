---
import '../styles/global.css';
import { profileData, withBase } from '../data/portfolio';
import InteractiveCursor from '../components/InteractiveCursor.astro';

interface Props {
  title?: string;
  description?: string;
}

const canonicalUrl = 'https://lhachas.github.io/portfolio/';
const ogImageUrl = 'https://lhachas.github.io/portfolio/assets/images/iam-4.jpg';

const {
  title = `${profileData.name} | Senior Backend & Full-Stack Developer (Node.js, NestJS, Java, AWS)`,
  description = profileData.heroSubtitle,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalUrl}#profilepage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'es-PE',
      dateModified: '2026-09-29',
      mainEntity: {
        '@id': `${canonicalUrl}#person`,
      },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl}#person`,
      name: profileData.name,
      givenName: 'Leonel',
      familyName: 'Hacha Salazar',
      jobTitle: 'Senior Backend Developer & Full Stack Developer',
      description: profileData.aboutLead,
      url: canonicalUrl,
      image: ogImageUrl,
      email: `mailto:${profileData.email}`,
      telephone: profileData.phone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Espinar, Cusco',
        addressCountry: 'PE',
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Baufest',
      },
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Universidad Nacional de San Antonio Abad del Cusco (UNSAAC)',
        },
        {
          '@type': 'EducationalOrganization',
          name: 'SENATI',
        },
      ],
      knowsLanguage: ['es', 'qu', 'en'],
      sameAs: [
        profileData.linkedin,
        profileData.github,
        profileData.facebook,
        profileData.instagram,
      ],
      knowsAbout: profileData.coreStackPills,
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: `${profileData.name} · Portafolio Profesional`,
      inLanguage: 'es-PE',
      publisher: {
        '@id': `${canonicalUrl}#person`,
      },
    },
  ],
};
---

<!doctype html>
<html
  lang="es"
  data-theme="light"
  style={`--bg-cartographer: url('${withBase('/assets/images/cartographer.png')}');`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profileData.name} />
    <meta
      name="keywords"
      content="Leonel Hacha Salazar, Senior Backend Developer, Full Stack Developer, Node.js, TypeScript, NestJS, Java, Spring Boot, WebFlux, AWS, Serverless, Microservices, Angular, React, Cusco, Perú"
    />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#1a1a1a" />

    <!-- Security Meta Headers (CSP, Referrer-Policy, X-Content-Type-Options) -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co https://formspree.io https://api.web3forms.com https://api.emailjs.com; base-uri 'self'; form-action 'self' https://formsubmit.co https://formspree.io; object-src 'none'; upgrade-insecure-requests;"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Canonical URL & Sitemap -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />

    <!-- Open Graph / LinkedIn & Recruiter Preview -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Leonel Hacha Salazar · Portafolio Senior Backend & Full-Stack" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Leonel Hacha Salazar - Senior Backend & Full-Stack Developer" />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Leonel Hacha Salazar - Senior Backend & Full-Stack Developer" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />

    <!-- Preload Critical Above-the-Fold Assets -->
    <link rel="preload" as="image" href={withBase('/assets/images/iam-4.jpg')} />

    <!-- Original Typography (Oswald + Victor Mono for Hero Typewriter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/victormono@latest/dist/index.min.css"
    />

    <!-- Original Icon Fonts (Icofont & Technology Icons) -->
    <link rel="stylesheet" href={withBase('/assets/css/plugins/icofont.css')} />
    <link rel="stylesheet" href={withBase('/assets/css/plugins/technology-icons.css')} />

    <!-- Structured Data (Schema.org ProfilePage + Person + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Flash-Free Theme & Strictly Validated Accent Initialization -->
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var urlTheme = params.get('theme');
          var savedTheme = urlTheme || localStorage.getItem('user-theme');
          var theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : 'light';
          document.documentElement.setAttribute('data-theme', theme);

          var validHex = /^#[0-9a-fA-F]{6}$/;
          var savedAccent = localStorage.getItem('user-accent-hex') || '';
          var savedAccentHover = localStorage.getItem('user-accent-hover') || '';
          if (validHex.test(savedAccent)) {
            document.documentElement.style.setProperty('--brand-primary', savedAccent);
          }
          if (validHex.test(savedAccentHover)) {
            document.documentElement.style.setProperty('--brand-primary-hover', savedAccentHover);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="antialiased selection:bg-[#cdb30c] selection:text-[#1a1a1a]">
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10001] focus:rounded-full focus:bg-[#cdb30c] focus:px-5 focus:py-2.5 focus:font-medium focus:text-[#1a1a1a]"
    >
      Saltar al contenido principal
    </a>

    <InteractiveCursor />

    <slot />

    <!-- Global Scroll-Reveal & Skill Progress Bar Observer -->
    <script>
      function initObservers() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. Reveal elements on scroll
        const revealEls = document.querySelectorAll('.reveal');
        if (prefersReducedMotion) {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  revealObserver.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );
          revealEls.forEach((el) => revealObserver.observe(el));
        }

        // 2. Animate skill progress bars when entering viewport
        const progressBars = document.querySelectorAll<HTMLElement>('.progres[data-value]');
        const skillObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const bar = entry.target as HTMLElement;
                const targetWidth = bar.getAttribute('data-value') || '0%';
                bar.style.width = targetWidth;
                skillObserver.unobserve(bar);
              }
            });
          },
          { threshold: 0.2 }
        );
        progressBars.forEach((bar) => skillObserver.observe(bar));
      }

      document.addEventListener('DOMContentLoaded', initObservers);
    </script>
  </body>
</html>
