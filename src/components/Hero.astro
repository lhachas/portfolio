---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { hero } = await getPortfolioContent(locale);
---

<!-- START HOME -->
<section class="section bg-home relative overflow-hidden" id="home" aria-label={hero.sectionAriaLabel}>
  <!-- Cinematic Architectural Background Canvas & Asset Viewport (Produced with Remotion) -->
  <div class="hero-cinematic-stage absolute inset-0 overflow-hidden pointer-events-none z-[1]" aria-hidden="true">
    <!-- Accessible Poster Picture Fallback (Zero network lag, instant paint, 34KB WebP) -->
    <picture class="hero-cinematic-poster absolute inset-0 w-full h-full">
      <source srcset={withBase('/assets/video/hero-cinematic-poster.webp')} type="image/webp" />
      <img
        src={withBase('/assets/video/hero-cinematic-poster.png')}
        alt=""
        class="w-full h-full object-cover object-center select-none"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <!-- High-Performance Looping Cinematic Video (Remotion Produced) -->
    <video
      id="hero-cinematic-video"
      class="hero-cinematic-video absolute inset-0 w-full h-full object-cover object-center select-none"
      autoplay
      muted
      loop
      playsinline
      poster={withBase('/assets/video/hero-cinematic-poster.webp')}
      preload="metadata"
    >
      <source src={withBase('/assets/video/hero-cinematic.webm')} type="video/webm" />
      <source src={withBase('/assets/video/hero-cinematic.mp4')} type="video/mp4" />
    </video>

    <!-- Pure Non-Destructive Dark Falloff Overlay (Ensures 100% Solid WCAG AAA text contrast) -->
    <div class="hero-cinematic-overlay absolute inset-0"></div>
  </div>

  <!-- Interactive Engineering Topology & Deterministic Signal Stream Canvas -->
  <canvas
    id="hero-topology-canvas"
    class="pointer-events-none absolute inset-0 z-[2] h-full w-full"
    aria-hidden="true"
  ></canvas>

  <div id="hero-parallax-stage" class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 w-full pt-2 pb-2">
    <div class="mx-auto max-w-5xl text-center">
      <!-- Live Recruiter Availability Status Pill (100% Solid Utilitarian Badge) -->
      <div class="mb-4 inline-flex items-center justify-center" data-hero-anim>
        <a
          href={hero.secondaryCta.href}
          class="hero-status-pill"
          data-cursor-label={hero.availabilityCursorLabel}
        >
          <span class="status-pulse-dot" aria-hidden="true"></span>
          <span>{hero.availabilityBadge}</span>
          <Icon name="check" size={14} class="text-gold shrink-0 inline-block" />
        </a>
      </div>

      <!-- Greeting -->
      <p class="hero-greeting text-[#cbd5e1] mb-1.5" data-hero-anim>
        {hero.greeting}
      </p>

      <!-- Single-Line Typed Headline (Preserves Soy + Victor Mono Italic Dynamic Accent Typed Text without 2-line jump) -->
      <h1
        class="home-title text-gold mb-0 flex flex-wrap sm:flex-nowrap items-center justify-center gap-x-3 pb-1 min-h-[3.2rem] sm:min-h-[3.6rem]"
        data-hero-anim
      >
        <span class="text-white font-light shrink-0">{hero.titlePrefix}</span>
        <span class="inline-flex items-center pb-0.5 sm:whitespace-nowrap">
          <em
            id="typed-output"
            class="typing italic font-semibold text-gold"
            data-strings={JSON.stringify(hero.typedStrings)}
          >
            {hero.typedStrings[0]}
          </em>
          <span class="typed-cursor" aria-hidden="true">|</span>
        </span>
      </h1>

      <!-- Value Proposition Subtitle (Unified .title-subtitle scale, 100% solid crisp text) -->
      <p class="title-subtitle mt-3 mb-0 mx-auto text-[#e2e8f0]" data-hero-anim>
        {hero.subtitle}
      </p>

      <!-- Core Architecture Stack Strip (100% Solid Pills with Official SVGL Brand Icon Badges) -->
      <div
        class="mt-5 flex flex-wrap items-center justify-center gap-2.5"
        aria-label={hero.architecturePillsAriaLabel}
        data-hero-anim
      >
        {
          hero.architecturePills.map((arch) => (
            <span class="hero-arch-pill" style={`--arch-brand: ${arch.brandColor};`}>
              <span class="hero-arch-icon-badge" aria-hidden="true">
                <Icon name={arch.icon} size={15} />
              </span>
              <span>{arch.label}</span>
            </span>
          ))
        }
      </div>

      <!-- Hero Action CTAs (1 Primary + 1 Secondary, 100% Solid Surfaces, WCAG AAA Contrast, Tactile Micro-Interactions) -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3.5" data-hero-anim>
        <a
          href={hero.primaryCta.href}
          class="hero-btn-primary"
          data-cursor-label={hero.primaryCta.cursorLabel}
        >
          <Icon name="terminal" size={17} class="shrink-0" />
          <span>{hero.primaryCta.label}</span>
          <Icon name="chevron-right" size={14} class="shrink-0" />
        </a>

        <a
          href={hero.secondaryCta.href}
          class="hero-btn-secondary"
          data-cursor-label={hero.secondaryCta.cursorLabel}
        >
          <Icon name="message" size={16} class="shrink-0 text-gold" />
          <span>{hero.secondaryCta.label}</span>
        </a>
      </div>

      <!-- Recruiter Impact Metrics Strip (100% Solid Non-Monotonous Architectural Cards) -->
      <div class="mt-7 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center" data-hero-metrics>
        {
          hero.metrics.map((metric) => {
            const isBrandAccent = metric.accentColor.toLowerCase() === '#cdb30c';
            const resolvedAccent = isBrandAccent ? 'var(--brand-gold)' : metric.accentColor;
            const iconTextColor = '#ffffff';
            return (
              <div
                class="hero-metric-card"
                data-tilt-card
                data-hero-metric-item
                style={`--metric-accent: ${resolvedAccent};`}
              >
                <div
                  class="mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[#1e222d]"
                  style={`background-color: ${resolvedAccent}; color: ${iconTextColor}; box-shadow: 0 3px 0 #0a0c10;`}
                >
                  <i class={`icofont ${metric.icon} text-lg`} aria-hidden="true"></i>
                </div>
                <div class="text-xl sm:text-2xl font-medium text-white tracking-wide">
                  {metric.value}
                </div>
                <div
                  class="mt-0.5 text-[13.5px] font-medium uppercase tracking-wider"
                  style={`color: ${resolvedAccent};`}
                >
                  {metric.label}
                </div>
                <div class="mt-1 text-[12.5px] text-[#cbd5e1] font-light tracking-wide">
                  {metric.detail}
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Animated Scroll-Down Indicator -->
      <div class="mt-6 flex justify-center" data-hero-anim>
        <a
          href={hero.scrollIndicator.href}
          class="hero-scroll-indicator"
          aria-label={hero.scrollIndicator.ariaLabel}
        >
          <span class="scroll-mouse" aria-hidden="true">
            <span class="scroll-wheel"></span>
          </span>
          <span>{hero.scrollIndicator.label}</span>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- END HOME -->

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHeroEffects() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;
    const typedEl = document.getElementById('typed-output');
    const heroSection = document.getElementById('home');
    const heroStage = document.getElementById('hero-parallax-stage');
    const cinematicVideo = document.getElementById('hero-cinematic-video') as HTMLVideoElement | null;

    if (cinematicVideo) {
      if (prefersReducedMotion) {
        cinematicVideo.pause();
        cinematicVideo.style.display = 'none';
      } else {
        cinematicVideo.play().catch(() => {});
      }
    }

    // 1. GSAP Orchestrated Entrance Timeline & Subtle Scroll Parallax
    if (!prefersReducedMotion && heroSection) {
      const heroAnimItems = heroSection.querySelectorAll('[data-hero-anim]');
      const metricItems = heroSection.querySelectorAll('[data-hero-metric-item]');

      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.fromTo(
        heroAnimItems,
        { y: 20, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 0.65, stagger: 0.08, clearProps: 'transform,opacity,visibility' }
      ).fromTo(
        metricItems,
        { y: 24, autoAlpha: 0, scale: 0.97 },
        { y: 0, autoAlpha: 1, scale: 1, duration: 0.55, stagger: 0.07, clearProps: 'transform,opacity,visibility' },
        '-=0.32'
      );

      if (heroStage) {
        gsap.to(heroStage, {
          yPercent: 10,
          ease: 'none',
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      }
    }

    // 2. Lightweight Single-Line Typewriter Effect
    if (typedEl && !prefersReducedMotion) {
      const raw = typedEl.getAttribute('data-strings');
      const strings: string[] = raw ? JSON.parse(raw) : [];
      if (strings.length > 0) {
        let strIndex = 0;
        let charIndex = strings[0].length;
        let isDeleting = true;

        const tick = () => {
          const currentFull = strings[strIndex];
          if (isDeleting) {
            charIndex--;
            typedEl.textContent = currentFull.substring(0, charIndex);
            if (charIndex === 0) {
              isDeleting = false;
              strIndex = (strIndex + 1) % strings.length;
              setTimeout(tick, 260);
              return;
            }
            setTimeout(tick, 38);
          } else {
            charIndex++;
            typedEl.textContent = currentFull.substring(0, charIndex);
            if (charIndex === currentFull.length) {
              isDeleting = true;
              setTimeout(tick, 2200);
              return;
            }
            setTimeout(tick, 76);
          }
        };

        setTimeout(tick, 1900);
      }
    }

    // 3. Solid 3D Perspective Tilt on Metric Cards
    if (heroSection && isFinePointer && !prefersReducedMotion) {
      const tiltCards = heroSection.querySelectorAll<HTMLElement>('[data-tilt-card]');
      tiltCards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const relX = (e.clientX - rect.left) / rect.width - 0.5;
          const relY = (e.clientY - rect.top) / rect.height - 0.5;
          const rotateX = (-relY * 5).toFixed(2);
          const rotateY = (relX * 5).toFixed(2);
          card.style.transform = `perspective(700px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });
    }

    // 3b. 3D Interactive Mouse Parallax across Hero Stage & Architecture Stack Pills
    if (heroSection && isFinePointer && !prefersReducedMotion && heroStage) {
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        const relX = (e.clientX - rect.left) / rect.width - 0.5;
        const relY = (e.clientY - rect.top) / rect.height - 0.5;

        // Stage perspective micro-tilt and smooth translation
        gsap.to(heroStage, {
          rotationY: relX * 5,
          rotationX: -relY * 5,
          x: relX * 14,
          y: relY * 10,
          duration: 0.45,
          ease: 'power2.out',
          transformPerspective: 1200,
        });

        // Layered micro-parallax on architecture pills
        const archPills = heroSection.querySelectorAll('.hero-arch-pill');
        archPills.forEach((pill, idx) => {
          const depth = (idx % 2 === 0 ? 1 : -1) * 6;
          gsap.to(pill, {
            x: relX * depth,
            y: relY * depth,
            duration: 0.35,
            ease: 'power1.out',
          });
        });
      });

      heroSection.addEventListener('mouseleave', () => {
        gsap.to(heroStage, {
          rotationY: 0,
          rotationX: 0,
          x: 0,
          y: 0,
          duration: 0.75,
          ease: 'power2.out',
        });
        const archPills = heroSection.querySelectorAll('.hero-arch-pill');
        gsap.to(archPills, { x: 0, y: 0, duration: 0.75, ease: 'power2.out' });
      });
    }

    // 3c. Magnetic Physics Micro-Interactions on CTA Buttons & Badges
    if (isFinePointer && !prefersReducedMotion) {
      const magneticTargets = document.querySelectorAll<HTMLElement>(
        '.hero-btn-primary, .hero-btn-secondary, .hero-status-pill'
      );
      magneticTargets.forEach((target) => {
        target.addEventListener('mousemove', (e) => {
          const rect = target.getBoundingClientRect();
          const relX = e.clientX - (rect.left + rect.width / 2);
          const relY = e.clientY - (rect.top + rect.height / 2);
          gsap.to(target, {
            x: relX * 0.24,
            y: relY * 0.24,
            duration: 0.25,
            ease: 'power2.out',
          });
        });
        target.addEventListener('mouseleave', () => {
          gsap.to(target, {
            x: 0,
            y: 0,
            duration: 0.55,
            ease: 'elastic.out(1, 0.4)',
          });
        });
      });
    }

    // 4. Kinetic Architectural Topology & Deterministic Signal Stream Engine
    const canvas = document.getElementById('hero-topology-canvas') as HTMLCanvasElement | null;
    if (!canvas || prefersReducedMotion) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let pointerX = -9999;
    let pointerY = -9999;
    let targetPointerX = -9999;
    let targetPointerY = -9999;
    let isVisibleOnScreen = true;

    const getActiveAccent = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--brand-gold').trim() || '#3f87f5';

    let activeAccent = getActiveAccent();

    window.addEventListener('portfolio:accent-change', ((e: CustomEvent<{ primary?: string }>) => {
      activeAccent = e.detail?.primary || getActiveAccent();
    }) as EventListener);

    // Track pointer with smooth interpolation
    heroSection?.addEventListener(
      'mousemove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        targetPointerX = e.clientX - rect.left;
        targetPointerY = e.clientY - rect.top;
      },
      { passive: true }
    );

    heroSection?.addEventListener(
      'mouseleave',
      () => {
        targetPointerX = -9999;
        targetPointerY = -9999;
      },
      { passive: true }
    );

    // Resize handling with devicePixelRatio support for crisp Retina rendering
    const resizeCanvas = () => {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    // Grid configuration
    const gridStep = 72;

    // Deterministic Signal Rails
    interface SignalRail {
      y: number;
      speed: number;
      pulses: { x: number; length: number; speed: number; color: string }[];
      deflection: number;
      velocity: number;
    }

    const railsCount = 6;
    const rails: SignalRail[] = [];

    const initRails = () => {
      rails.length = 0;
      const spacing = height / (railsCount + 1);
      for (let i = 0; i < railsCount; i++) {
        const y = Math.round((i + 1) * spacing);
        const speed = (0.6 + (i % 3) * 0.4) * (i % 2 === 0 ? 1 : -1);
        const railPulses = [
          {
            x: Math.random() * width,
            length: 36 + Math.random() * 40,
            speed: Math.abs(speed) * 1.8 + 0.4,
            color: i % 2 === 0 ? 'accent' : '#2563eb',
          },
          {
            x: Math.random() * width,
            length: 24 + Math.random() * 32,
            speed: Math.abs(speed) * 1.4 + 0.3,
            color: i === 1 ? '#10b981' : i === 3 ? '#cdb30c' : 'accent',
          },
        ];
        rails.push({ y, speed, pulses: railPulses, deflection: 0, velocity: 0 });
      }
    };
    initRails();
    window.addEventListener('resize', initRails, { passive: true });

    // Animation Loop with Spring Physics
    const springK = 0.08;
    const damping = 0.88;

    const renderTopology = () => {
      if (!isVisibleOnScreen) {
        requestAnimationFrame(renderTopology);
        return;
      }

      // Pointer spring interpolation
      if (targetPointerX === -9999) {
        pointerX = -9999;
        pointerY = -9999;
      } else {
        pointerX += (targetPointerX - pointerX) * 0.2;
        pointerY += (targetPointerY - pointerY) * 0.2;
      }

      ctx.clearRect(0, 0, width, height);

      // 1. Subtle Architectural Grid Lines & Crosshairs
      ctx.lineWidth = 1;
      ctx.strokeStyle = '#181e2b';
      ctx.beginPath();
      for (let x = 0; x <= width; x += gridStep) {
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, height);
      }
      ctx.stroke();

      // Precision coordinate marks at intersections
      ctx.strokeStyle = '#252f44';
      ctx.beginPath();
      for (let x = 0; x <= width; x += gridStep) {
        for (let y = 0; y <= height; y += gridStep) {
          ctx.moveTo(x - 2, y + 0.5);
          ctx.lineTo(x + 2, y + 0.5);
          ctx.moveTo(x + 0.5, y - 2);
          ctx.lineTo(x + 0.5, y + 2);
        }
      }
      ctx.stroke();

      // 2. High-Performance Signal Rails with Elastic Cursor Deflection
      rails.forEach((rail) => {
        // Calculate elastic cursor interaction
        if (pointerX !== -9999 && pointerY !== -9999) {
          const dy = pointerY - rail.y;
          const dist = Math.abs(dy);
          if (dist < 120) {
            const force = (1 - dist / 120) * (dy > 0 ? -18 : 18);
            rail.velocity += (force - rail.deflection) * springK;
          }
        }
        // Spring physics relaxation
        rail.velocity += -rail.deflection * springK;
        rail.velocity *= damping;
        rail.deflection += rail.velocity;

        const currentY = rail.y + rail.deflection;

        // Draw base architectural track line
        ctx.strokeStyle = '#1e283a';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, currentY);
        ctx.lineTo(width, currentY);
        ctx.stroke();

        // Draw traveling signal pulses
        rail.pulses.forEach((pulse) => {
          pulse.x += pulse.speed;
          if (pulse.x > width + pulse.length) {
            pulse.x = -pulse.length;
          }

          const pulseColor = pulse.color === 'accent' ? activeAccent : pulse.color;
          ctx.strokeStyle = pulseColor;
          ctx.lineWidth = 2;
          ctx.beginPath();
          const startX = Math.max(0, pulse.x);
          const endX = Math.min(width, pulse.x + pulse.length);
          if (endX > startX) {
            ctx.moveTo(startX, currentY);
            ctx.lineTo(endX, currentY);
            ctx.stroke();

            // Leading micro-node with subtle glow
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(endX, currentY, 2, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      });

      requestAnimationFrame(renderTopology);
    };

    // Pause off-screen via IntersectionObserver for zero wasted cycles
    if ('IntersectionObserver' in window && heroSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          isVisibleOnScreen = entries[0].isIntersecting;
        },
        { threshold: 0.05 }
      );
      observer.observe(heroSection);
    }

    renderTopology();
  }

  document.addEventListener('DOMContentLoaded', initHeroEffects);
</script>

