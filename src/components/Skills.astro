---
import { getPortfolioContent, type PortfolioLocale } from '../data/portfolio';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { skillsSection } = await getPortfolioContent(locale);
const skillCategories = skillsSection.categories;
---

<!-- START SKILLS -->
<section class="section th-secondary" id="skills" aria-labelledby="skills-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title Header (Solid Architectural Medallion .title-icon) -->
    <div class="text-center reveal">
      <i class={`icofont ${skillsSection.sectionIcon} title-icon`} aria-hidden="true"></i>
      <h2 id="skills-heading" class="title">
        {skillsSection.titlePrefix} <span class="font-medium">{skillsSection.titleHighlight}</span>
      </h2>
      <p class="txt-primary mt-3 title-subtitle mx-auto">
        {skillsSection.subtitle}
      </p>
    </div>

    <!-- Interactive Pillar Filter (100% Solid Non-Monotonous Category Filter Tabs) -->
    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-2.5 reveal"
      role="tablist"
      aria-label={skillsSection.filterAriaLabel}
    >
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-skill-filter="all"
        style="--tab-accent: var(--brand-gold); --tab-text: var(--brand-on-gold);"
        class="skill-filter-btn active min-h-[42px] rounded-full px-5 py-2 text-xs font-semibold uppercase tracking-wider transition-all duration-200 cursor-pointer"
      >
        {skillsSection.filterAllLabel}
      </button>
      {
        skillCategories.map((category) => (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-skill-filter={category.id}
            style={`--tab-accent: ${category.accentColor}; --tab-text: #ffffff;`}
            class="skill-filter-btn min-h-[42px] rounded-full px-4 py-2 text-xs font-medium uppercase tracking-wider transition-all duration-200 cursor-pointer inline-flex items-center gap-2"
          >
            <span
              class="h-2.5 w-2.5 rounded-full shrink-0"
              style={`background-color: ${category.accentColor};`}
              aria-hidden="true"
            ></span>
            <span>{category.title}</span>
          </button>
        ))
      }
    </div>

    <!-- 2x2 Skills Grid (100% Solid Category-Accented Cards + Official Brand Tech Badges) -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-7" id="skills-grid">
      {
        skillCategories.map((category, idx) => (
          <article
            class="card-box th-primary reveal justify-between"
            data-skill-card={category.id}
            style={`--card-accent: ${category.accentColor}; --reveal-delay: ${(idx % 2) * 100}ms;`}
          >
            <div>
              <!-- Category Pillar Badge + 45deg Diamond Rotating Icon -->
              <div class="flex items-center justify-between mb-1">
                <span
                  class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white"
                  style={`background-color: ${category.accentColor};`}
                >
                  <span>{skillsSection.pillarPrefixLabel} 0{idx + 1}</span>
                </span>
                <span
                  class="text-xs font-semibold uppercase tracking-wider"
                  style={`color: ${category.accentColor};`}
                >
                  {category.items.length} {skillsSection.domainsCountSuffix}
                </span>
              </div>

              <div class="card-icon">
                <i class={`${category.icon} icon`} aria-hidden="true"></i>
              </div>

              <h3 class="card-title text-center">
                {category.title}
              </h3>
              <p class="detail-copy mt-1.5 text-center" style="color: var(--txt-muted);">
                {category.subtitle}
              </p>

              <!-- Animated Skill Progress Bars with Official Solid Brand Icon Badges -->
              <div class="skills-list mt-6">
                {
                  category.items.map((skill) => (
                    <div class="skill-item" style={`--skill-brand: ${skill.brandColor};`}>
                      <div class="skill-text">
                        <span class="inline-flex items-center min-w-0">
                          <span class="skill-brand-badge" aria-hidden="true">
                            <i class={skill.icon}></i>
                          </span>
                          <span class="font-medium tracking-wide truncate">{skill.name}</span>
                        </span>
                        <span class="skill-level-pill">
                          {skill.level}
                        </span>
                      </div>
                      <div class="skill-progress">
                        <div
                          class="progres"
                          style={`width: ${skill.level};`}
                          data-value={skill.level}
                          role="progressbar"
                          aria-label={`${skill.name}: ${skill.level}`}
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Granular Tech Pills from 2026 CV (Solid Category-Accented Pills) -->
            <div class="mt-6 pt-4 border-t-2" style="border-color: var(--card-border);">
              <span class="label-c block mb-2.5 text-center" style={`color: ${category.accentColor};`}>
                {skillsSection.verifiedStackHeading}
              </span>
              <div class="flex flex-wrap justify-center gap-1.5">
                {
                  category.tags.map((tag) => (
                    <span class="tech-pill">
                      {tag}
                    </span>
                  ))
                }
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Original Top-Anchored SVG Wave Divider (Hangs downward from #about into #skills) -->
  <svg
    class="wave"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</section>
<!-- END SKILLS -->

<style>
  .skill-filter-btn {
    background-color: var(--th-primary);
    color: var(--txt-primary);
    border: 2px solid var(--card-border);
    box-shadow: 0 3px 0 var(--card-border);
  }
  .skill-filter-btn:hover {
    border-color: var(--tab-accent, var(--brand-gold));
    transform: translateY(-2px);
  }
  .skill-filter-btn.active {
    background-color: var(--tab-accent, var(--brand-gold));
    color: var(--tab-text, var(--brand-on-gold));
    border-color: var(--tab-accent, var(--brand-gold));
    box-shadow: 0 3px 0 #091526;
    font-weight: 600;
  }
</style>

<script is:inline>
  (() => {
    const filterBtns = document.querySelectorAll('[data-skill-filter]');
    const skillCards = document.querySelectorAll('[data-skill-card]');
    const skillsGrid = document.getElementById('skills-grid');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-skill-filter');

        filterBtns.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        if (skillsGrid) {
          skillsGrid.classList.toggle('lg:grid-cols-1', filter !== 'all');
          skillsGrid.classList.toggle('lg:grid-cols-2', filter === 'all');
          skillsGrid.classList.toggle('max-w-3xl', filter !== 'all');
          skillsGrid.classList.toggle('mx-auto', filter !== 'all');
        }

        skillCards.forEach((card) => {
          const cardId = card.getAttribute('data-skill-card');
          const shouldShow = filter === 'all' || cardId === filter;
          if (shouldShow) {
            card.classList.remove('hidden');
            const bars = card.querySelectorAll('.progres[data-value]');
            bars.forEach((bar) => {
              bar.style.width = '0%';
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  bar.style.width = bar.getAttribute('data-value') || '90%';
                });
              });
            });
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
