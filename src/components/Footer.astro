---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';
import BrandSignature from './BrandSignature.astro';
import Icon from './Icon.astro';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { footer, profile, socialLinks, navigation } = await getPortfolioContent(locale);
const navItems = navigation.items;
const currentYear = new Date().getFullYear();

const navIconMap: Record<string, 'home' | 'user' | 'code' | 'terminal' | 'briefcase' | 'layers' | 'mail'> = {
  home: 'home',
  about: 'user',
  skills: 'code',
  projects: 'terminal',
  experiences: 'briefcase',
  services: 'layers',
  contact: 'mail',
};

// Dos colores en el rol: parte principal clara + especialidad en acento (split por "|")
const roleParts = profile.roleHeadline.split('|').map((part) => part.trim());
const roleMain = roleParts[0] ?? profile.roleHeadline;
const roleSub = roleParts.length > 1 ? roleParts.slice(1).join(' | ') : null;
---

<!-- START FOOTER -->
<footer class="footer-section" aria-label={footer.ariaLabel}>
  <div class="footer-content-wrapper mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Traza de circuito: eco del hero, conecta el footer con la identidad del sitio -->
    <div class="footer-circuit-line" aria-hidden="true">
      <span class="footer-circuit-node" style="left: 8%;"></span>
      <span class="footer-circuit-node footer-circuit-node--accent" style="left: 46%;"></span>
      <span class="footer-circuit-node" style="left: 87%;"></span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-12">
      <!-- Columna A: Marca, propuesta de valor y estado en vivo -->
      <div class="lg:col-span-5">
        <div class="mb-7">
          <BrandSignature
            avatarImage={profile.avatarImage}
            avatarAlt={profile.avatarAlt}
            subtitle={profile.brandSubtitle || 'Backend & Full Stack'}
          />
        </div>

        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] mb-3">
          <span style="color: var(--txt-primary);">{roleMain}</span>
          {roleSub && <span class="text-gold">&nbsp;| {roleSub}</span>}
        </p>

        <p class="text-[14px] leading-relaxed text-[#cbd5e1] max-w-sm mb-6">
          {footer.brandSummary}
        </p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5">
          <span class="inline-flex items-center gap-2 rounded-full border border-[#22c55e] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-white" style="background-color: var(--chrome-bg);">
            <span class="status-pulse-dot" aria-hidden="true"></span>
            <span>{footer.availabilityBadge}</span>
          </span>
          <span class="text-xs text-[#cbd5e1] inline-flex items-center gap-1.5">
            <Icon name="map-pin" size={14} class="text-gold shrink-0" />
            <span>{profile.location}</span>
          </span>
        </div>
      </div>

      <!-- Columna B: Navegación ejecutiva + CV oficial -->
      <div class="lg:col-span-3">
        <div class="mb-4">
          <span class="footer-col-label block">{footer.navColumnTitle}</span>
          <span class="footer-col-count block mt-1.5">{footer.navColumnBadge}</span>
        </div>

        <nav aria-label={footer.navAriaLabel}>
          <ul class="flex flex-col gap-0.5" role="list">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.id === 'home' ? withBase(locale === 'en' ? '/en/' : '/') : withBase(locale === 'en' ? `/en/${item.id}` : `/${item.id}`)}
                    data-nav-link={item.id}
                    class="footer-nav-link"
                  >
                    <Icon name={navIconMap[item.id] || 'layers'} size={15} />
                    <span>{item.label}</span>
                    <Icon name="chevron-right" size={13} class="footer-nav-chevron" />
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={withBase(navigation.languageSwitcher.targetHref)}
                class="footer-nav-link"
                data-lang-switch
                aria-label={navigation.languageSwitcher.ariaLabel}
              >
                <Icon name="globe" size={15} />
                <span>{navigation.languageSwitcher.currentCode} / {navigation.languageSwitcher.targetCode}</span>
                <Icon name="chevron-right" size={13} class="footer-nav-chevron" />
              </a>
            </li>
          </ul>
        </nav>

        <div class="mt-6 pt-5 border-t" style="border-color: var(--chrome-border);">
          <span class="block text-[11px] font-semibold uppercase tracking-widest mb-3" style="color: var(--txt-muted);">
            {footer.cvDownloadHeading}
          </span>
          <a
            href={withBase(profile.cvPrimary.url)}
            target="_blank"
            rel="noopener noreferrer"
            download={profile.cvPrimary.filename}
            data-cv-lang={profile.cvPrimary.langCode}
            aria-label={profile.cvPrimary.ariaLabel}
            class="btn-cv-solid w-full !min-h-[38px] !px-3 !py-1.5 !text-xs justify-center whitespace-nowrap"
          >
            <Icon name="file-pdf" size={15} class="mr-1.5 shrink-0" />
            <span>{profile.cvPrimary.labelFooter}</span>
          </a>
        </div>
      </div>

      <!-- Columna C: Canales oficiales y contacto directo -->
      <div class="lg:col-span-4">
        <div class="mb-4">
          <span class="footer-col-label block">{footer.channelsColumnTitle}</span>
          <span class="footer-col-count block mt-1.5">{footer.channelsColumnBadge}</span>
        </div>

        <p class="text-[13.5px] leading-relaxed text-[#cbd5e1] mb-5">
          {footer.channelsDescription}
        </p>

        <ul class="flex flex-col gap-2 mb-6" role="list">
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="footer-contact-row"
              data-cursor-label="Email"
            >
              <span class="footer-contact-icon" style="color: #EA4335;" aria-hidden="true">
                <Icon name="mail" size={15} />
              </span>
              <span class="truncate">{profile.email}</span>
            </a>
          </li>
          <li>
            <a
              href={`tel:${profile.phoneClean}`}
              class="footer-contact-row"
              data-cursor-label="Teléfono"
            >
              <span class="footer-contact-icon" style="color: #25D366;" aria-hidden="true">
                <Icon name="phone" size={15} />
              </span>
              <span class="font-medium">{profile.phone}</span>
            </a>
          </li>
        </ul>

        <ul class="flex flex-wrap items-center gap-2" role="list">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target={social.id === 'email' ? undefined : '_blank'}
                  rel={social.id === 'email' ? undefined : 'noopener noreferrer'}
                  class={`social-icon-btn ${social.id}`}
                  data-magnetic
                  data-cursor-label={social.name}
                  aria-label={`${social.name} - ${profile.name} (${social.handle})`}
                  title={`${social.name}: ${social.handle}`}
                >
                  <Icon name={social.id} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Attribution & Copyright Bar -->
    <div class="mt-12 pt-5 border-t" style="border-color: var(--chrome-border);" >
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <p class="text-[14px] font-light text-[#cbd5e1] mb-0">
          {currentYear} © <span class="font-medium text-white">LHachaS</span>. {footer.copyrightPrefix}{' '}
          <a
            class="text-gold hover:underline font-medium"
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            {profile.name}
          </a>
        </p>

        <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-[#cbd5e1]">
          <span class="rounded-full border px-3 py-1" style="border-color: var(--chrome-border); background-color: var(--chrome-bg);">
            {footer.stackBadgeLabel} <strong class="text-gold font-medium">{footer.stackBadgeValue}</strong>
          </span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--chrome-border); background-color: var(--chrome-bg);">
            {footer.designBadgeLabel} <strong class="text-white font-medium">{footer.designBadgeValue}</strong>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Top-Anchored SVG Wave Divider (Height Capped & z-index: 1 so it NEVER overlaps social buttons) -->
  <svg
    class="wave"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1920 81.717"
    preserveAspectRatio="none"
    xml:space="preserve"
    aria-hidden="true"
  >
    <path
      d="M1920,0c0,0-109.246,46.107-316.333,67.334C1343.5,94,1137.095,77.238,999.167,67.5C854,57.25,637.662,24.697,541.709,18.834C375.334,8.666,147,11,0,37.875V0H1920L1920,0z"
    ></path>
  </svg>
</footer>
<!-- END FOOTER -->
