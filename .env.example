# ============================================================================
# Configuración Opcional del Formulario de Contacto (Astro 5)
# ============================================================================
# Por defecto, el formulario envía correos reales mediante la API AJAX de
# FormSubmit (https://formsubmit.co/ajax/lionelsh.salazar@gmail.com) sin
# requerir claves adicionales.
#
# Si deseas conectar tu propio proyecto de Formspree, Web3Forms o EmailJS,
# descomenta y configura cualquiera de las siguientes opciones en un archivo .env:

# Opción A: Formspree (https://formspree.io/)
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/tu_codigo_formspree

# Opción B: Web3Forms (https://web3forms.com/)
# PUBLIC_WEB3FORMS_KEY=tu_access_key_de_web3forms

# Opción C: EmailJS (https://www.emailjs.com/)
# PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
# PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key_emailjs
