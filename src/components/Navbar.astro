---
import { getPortfolioContent, withBase, type PortfolioLocale } from '../data/portfolio';

interface Props {
  locale?: PortfolioLocale;
}

const { locale = 'es' } = Astro.props;
const { navigation, profile } = await getPortfolioContent(locale);
const navItems = navigation.items;
const { languageSwitcher } = navigation;
---

<!-- START NAVBAR -->
<header>
  <nav
    class="navbar-custom fixed top-0 left-0 right-0"
    id="navbar"
    aria-label={navigation.ariaLabel}
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex min-h-[72px] items-center justify-between">
        <!-- Brand Logo (Preserves boy.png + LHachaS with dynamic accent Hacha) -->
        <a class="navbar-brand-logo" href={`#${navItems[0]?.id || 'home'}`} aria-label={navigation.brandAriaLabel}>
          <img
            class="navbar-brand-img"
            src={withBase(profile.avatarImage)}
            alt={profile.avatarAlt}
            width="46"
            height="46"
          />
          <div>
            {profile.brandPrefix}<span class="text-gold">{profile.brandHighlight}</span>{profile.brandSuffix}
          </div>
        </a>

        <!-- Desktop Navigation Links (Preserves icon above uppercase text + dynamic accent active block) -->
        <ul class="hidden lg:flex items-stretch mx-auto" id="navbar-navlist">
          {
            navItems.map((item, index) => (
              <li class="flex">
                <a
                  href={`#${item.id}`}
                  data-nav-link={item.id}
                  class:list={['nav-item-link', { active: index === 0 }]}
                >
                  <i class={`nav-icon icofont ${item.icon}`} aria-hidden="true" />
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Right Controls: Phone + Language Switcher (ES/EN) + Theme Switcher + Mobile Hamburger -->
        <div class="flex items-center gap-2.5 sm:gap-3.5">
          <a
            href={`tel:${profile.phoneClean}`}
            class="hidden xl:inline-flex items-center gap-1.5 text-white hover:text-gold transition-colors text-sm font-semibold tracking-wide"
            aria-label={profile.phone}
          >
            <i class="icofont icofont-ui-cell-phone text-gold text-lg" aria-hidden="true"></i>
            <span class="text-sm font-normal tracking-wider">{profile.phone}</span>
          </a>

          <!-- Bilingual Language Switcher (100% Solid Pill) -->
          <a
            href={withBase(languageSwitcher.targetHref)}
            data-lang-switch
            data-magnetic
            class="nav-control-btn inline-flex h-11 items-center justify-center gap-1.5 rounded-full px-3.5 text-xs font-semibold uppercase tracking-widest cursor-pointer"
            aria-label={languageSwitcher.ariaLabel}
            title={languageSwitcher.title}
          >
            <i class="icofont icofont-globe text-gold text-base" aria-hidden="true"></i>
            <span>{languageSwitcher.currentCode}</span>
            <span class="opacity-60" aria-hidden="true">/</span>
            <span class="text-gold">{languageSwitcher.targetCode}</span>
          </a>

          <!-- Light / Dark Mode Switcher (Preserves icofont-night / icofont-sun-alt - 100% Solid) -->
          <button
            type="button"
            id="theme-toggle-btn"
            data-magnetic
            class="nav-control-btn inline-flex h-11 w-11 items-center justify-center rounded-full cursor-pointer"
            aria-label={navigation.themeToggleAriaLabel}
            title={navigation.themeToggleTitle}
          >
            <i id="theme-toggle-icon" class="icofont icofont-night text-lg" aria-hidden="true"></i>
          </button>

          <!-- Mobile Menu Button -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="nav-control-btn lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-lg cursor-pointer"
            aria-controls="navbarCollapse"
            aria-expanded="false"
            aria-label={navigation.mobileMenuAriaLabel}
          >
            <i id="mobile-menu-icon" class="icofont icofont-navigation-menu text-xl" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Collapsible Navigation -->
      <div
        id="navbarCollapse"
        class="hidden lg:hidden border-t-2 border-[#252a37] bg-[#14171f] pb-4 pt-2"
      >
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            navItems.map((item, index) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-nav-link={item.id}
                  class:list={['nav-item-link rounded-lg py-3', { active: index === 0 }]}
                >
                  <i class={`nav-icon icofont ${item.icon}`} aria-hidden="true" />
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 pt-3 border-t-2 border-[#252a37] flex flex-wrap items-center justify-center gap-4 sm:hidden">
          <a
            href={`tel:${profile.phoneClean}`}
            class="inline-flex items-center gap-2 text-white text-sm font-semibold"
          >
            <i class="icofont icofont-ui-cell-phone text-gold text-lg" aria-hidden="true"></i>
            <span>{profile.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
<!-- END NAVBAR -->

<script>
  function setupNavbar() {
    const navbar = document.getElementById('navbar');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('navbarCollapse');
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-toggle-icon');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const langLinks = document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]');

    // Preserve active section hash when switching ES <-> EN
    langLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.location.hash) {
          const baseHref = link.getAttribute('href')?.split('#')[0] || '';
          if (baseHref) {
            link.setAttribute('href', `${baseHref}${window.location.hash}`);
          }
        }
      });
    });

    // Sync theme icon with current data-theme
    function syncThemeIcon() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      if (themeIcon) {
        themeIcon.className = current === 'dark' ? 'icofont icofont-sun-alt text-lg text-gold' : 'icofont icofont-night text-lg';
      }
    }
    syncThemeIcon();

    // Toggle Light/Dark Theme
    themeBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('user-theme', next);
      } catch (e) {}
      syncThemeIcon();
    });

    // Mobile Menu Toggle
    mobileBtn?.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu?.classList.toggle('hidden');
    });

    // Close mobile menu when clicking a link
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024 && mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Sticky Navbar state using passive scroll
    const updateSticky = () => {
      if (!navbar) return;
      if (window.scrollY > 40) {
        navbar.classList.add('nav-sticky');
      } else {
        navbar.classList.remove('nav-sticky');
      }
    };
    updateSticky();
    window.addEventListener('scroll', updateSticky, { passive: true });

    // Deterministic Scrollspy based on viewport scroll position
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    const updateScrollSpy = () => {
      const scrollPos = window.scrollY + 240;
      let currentId = 'home';
      if (window.scrollY >= 120) {
        for (const section of sections) {
          if (section.offsetTop <= scrollPos) {
            currentId = section.id;
          }
        }
      }
      navLinks.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-link') === currentId;
        link.classList.toggle('active', isMatch);
      });
    };
    updateScrollSpy();
    window.addEventListener('scroll', updateScrollSpy, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', setupNavbar);
</script>

